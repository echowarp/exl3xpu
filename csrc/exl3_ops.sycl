#include <map>
// Host launchers + torch bindings for EXL3 ESIMD kernels.
#include <torch/all.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include "exl3_esimd.h"
#include "fa_esimd.h"
#include "fa_spec_esimd.h"
#include "fa_prefill_i8.h"
#include "topkp_sycl.h"
#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
#include "norm_sycl.h"
static int g_norm_wg = 128;
static int exl3_norm_wg() { return g_norm_wg; }
static void exl3_set_norm_wg(int64_t n) { g_norm_wg = (int)n; }

using namespace exl3;

static sycl::queue& queue_of(const at::Tensor& t) {
    return c10::xpu::getCurrentXPUStream(t.device().index()).queue();
}

static int round_up(int a, int b) { return (a + b - 1) / b * b; }
// MB=64 DPAS: two tiles per thread in 256-register mode (M=64 linears 120 -> 87 ms on B70)
#ifndef EXL3_NO_DPAS64_LARGE_GRF
#define EXL3_DPAS64_LARGE_GRF
#endif
#ifndef EXL3_DPAS64_NT
#define EXL3_DPAS64_NT 2
#endif
static int g_local = 8;       // work-group size (threads) for the GEMV / DPAS launches
// MB=24 DPAS block for 17..24 rows (3 x 8-row DPAS, 2 tiles/thread): all linears M=17 43.3 -> 41.1 ms,
// M=24 45.0 -> 42.6 (NT=4 spills: ~110 ms). Opt out with EXL3_NO_DPAS_MB24.
#ifndef EXL3_NO_DPAS_MB24
#define EXL3_DPAS_MB24
#endif
// MB=40/48 blocks (256-GRF, NT=2, split-K target as MB=64) for 33..48 rows (C16 thinking-on runs ~10 streams =
// ~40 rows): all linears M=33 59.7 -> 56.9, M=40 61.9 -> 58.5, M=48 64.3 -> 61.6 ms. Opt out: EXL3_NO_DPAS_MB48.
#ifndef EXL3_NO_DPAS_MB48
#define EXL3_DPAS_MB48
#endif
static int g_max_mb = 64;     // largest DPAS row block; M above it runs as several blocks
void exl3_set_max_mb(int64_t n) { g_max_mb = (int)n; }
void exl3_set_local(int64_t n) { g_local = (int)n; }

template <typename TIn>
static void launch_had_in(const at::Tensor& x, const at::Tensor& suh, at::Tensor& xh, sycl::queue& q,
                          bool row_major = false) {
    int M = x.size(0), Kdim = x.size(1), S = suh.size(0), Mp = xh.size(1);
    int n = S * (row_major ? M : Mp) * (Kdim / 128);
    HadInKernel<TIn> k{reinterpret_cast<const TIn*>(x.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
                       reinterpret_cast<fp16*>(xh.data_ptr()), M, Kdim, S, (int)x.stride(0), Mp, row_major ? 1 : 0};
    int local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

template <typename TOut, typename TPart = float>
static void launch_had_out(const at::Tensor& part, int P, const at::Tensor& svh, at::Tensor& out, sycl::queue& q) {
    int M = out.size(0), N = out.size(1);
    int n = M * (N / 128);
    HadOutKernel<TOut, TPart> k{reinterpret_cast<const TPart*>(part.data_ptr()), reinterpret_cast<const fp16*>(svh.data_ptr()),
                         reinterpret_cast<TOut*>(out.data_ptr()), M, N, P, (int)out.stride(0)};
    int local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

#ifdef EXL3_LUT
// one table per (device, codebook), built on first use from decode_cb_h itself (bit-exact by construction)
static const fp16* lut_for(int cb, const at::Tensor& like, sycl::queue& q) {
    static std::map<std::pair<int, int>, at::Tensor> tabs;
    auto key = std::make_pair((int)like.device().index(), cb);
    auto it = tabs.find(key);
    if (it == tabs.end()) {
        auto t = at::empty({65536}, like.options().dtype(at::kHalf));
        fp16* p = reinterpret_cast<fp16*>(t.data_ptr());
        q.submit([&](sycl::handler& h) {
            if (cb == 1) h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<1>{p});
            else if (cb == 2) h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<2>{p});
            else h.parallel_for(sycl::nd_range<1>(4096, 16), LutKernel<0>{p});
        });
        q.wait();
        it = tabs.emplace(key, t).first;
    }
    return reinterpret_cast<const fp16*>(it->second.data_ptr());
}
#endif

template <int K, int CB, int MR, int NT>
static void launch_gemv(const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard, at::Tensor& part,
                        int M, int Kdim, int N, int P, int rows_per_split, sycl::queue& q) {
    int tiles_n = N / 16;
    int n_strips = tiles_n / NT;
    GemvKernel<K, CB, MR, NT> k{reinterpret_cast<const fp16*>(xh.data_ptr()),
                                reinterpret_cast<const uint32_t*>(tr.data_ptr()),
                                shard.data_ptr<int>(), part.data_ptr<float>(),
                                M, Kdim, N, tiles_n, rows_per_split, n_strips};
#ifdef EXL3_LUT
    k.lut = lut_for(CB, xh, q);
#endif
    int n = n_strips * P;
    int local = g_local;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

template <int K, int CB, int MB, int NT>
static void launch_dpas(const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard, at::Tensor& part,
                        int M, int Kdim, int N, int P, int rows_per_split, sycl::queue& q) {
    int tiles_n = N / 16;
    int n_strips = tiles_n / NT;
    int m_blocks = (M + MB - 1) / MB;
    TORCH_CHECK(xh.size(-2) == m_blocks * MB || (xh.dim() == 4 && xh.size(2) == m_blocks * MB), "xh rows must be padded to MB");
    DpasKernel<K, CB, MB, NT> k{reinterpret_cast<const fp16*>(xh.data_ptr()),
                                reinterpret_cast<const uint32_t*>(tr.data_ptr()),
                                shard.data_ptr<int>(), part.data_ptr<float>(),
                                M, Kdim, N, tiles_n, rows_per_split, n_strips, m_blocks, m_blocks * MB};
    int n = n_strips * m_blocks * P;
    int local = g_local;
#if defined(EXL3_DPAS_LARGE_GRF) || defined(EXL3_DPAS64_LARGE_GRF)
#ifdef EXL3_DPAS_LARGE_GRF
    constexpr bool large = true;
#elif defined(EXL3_DPAS24_LARGE_GRF)
    constexpr bool large = (MB >= 24);
#elif defined(EXL3_DPAS32_LARGE_GRF)
    constexpr bool large = (MB >= 32);
#else
    // cliff: EXL3_DPAS40_SMALLGRF / EXL3_DPAS48_SMALLGRF keep the MB=40 / 48 blocks in 128-GRF mode
    // (twice the resident threads; the 32 -> 36 row cliff came from the switch to 256-GRF NT=2 at MB=40)
    constexpr bool large = (MB >= 40)
#ifdef EXL3_DPAS40_SMALLGRF
        && MB != 40
#endif
#ifdef EXL3_DPAS48_SMALLGRF
        && MB != 48
#endif
        ;
#endif
    if constexpr (large) {
        // 256-register mode: room for the MB x 16 x NT accumulator without spills
        sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
        q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), props, k); });
    } else {
        q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
    }
#else
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
#endif
}

static int g_cur_nt = 0;   // per-shape NT override for MB24/32 (0 = default, 1 = NT1)
template <int K, int CB>
static bool dispatch_dpas(int MB, const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard,
                          at::Tensor& part, int M, int Kdim, int N, int P, int rps, sycl::queue& q) {
    switch (MB) {
#ifndef EXL3_DPAS8_NT
#define EXL3_DPAS8_NT 4
#endif
#ifndef EXL3_DPAS4_NT
#define EXL3_DPAS4_NT 4
#endif
#ifdef EXL3_DPAS_MB4
        case 4:  launch_dpas<K, CB, 4, EXL3_DPAS4_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#endif
        case 8:  launch_dpas<K, CB, 8, EXL3_DPAS8_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
        case 16: launch_dpas<K, CB, 16, 4>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#ifdef EXL3_DPAS_MB24
#ifndef EXL3_DPAS24_NT
#define EXL3_DPAS24_NT 2
#endif
        case 24: if (g_cur_nt == 1) launch_dpas<K, CB, 24, 1>(xh, tr, shard, part, M, Kdim, N, P, rps, q); else launch_dpas<K, CB, 24, EXL3_DPAS24_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#endif
#ifndef EXL3_DPAS32_NT
#define EXL3_DPAS32_NT 2
#endif
        case 32: if (g_cur_nt == 1) launch_dpas<K, CB, 32, 1>(xh, tr, shard, part, M, Kdim, N, P, rps, q); else launch_dpas<K, CB, 32, EXL3_DPAS32_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#ifdef EXL3_DPAS_MB48
#ifndef EXL3_DPAS40_NT
#define EXL3_DPAS40_NT 2
#endif
#ifndef EXL3_DPAS48_NT
#define EXL3_DPAS48_NT 2
#endif
        case 40: launch_dpas<K, CB, 40, EXL3_DPAS40_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
        case 48: launch_dpas<K, CB, 48, EXL3_DPAS48_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#endif
#ifndef EXL3_DPAS64_NT
#define EXL3_DPAS64_NT 1
#endif
        case 64: launch_dpas<K, CB, 64, EXL3_DPAS64_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
#ifdef EXL3_K5_MB128
        case 96: launch_dpas<K, CB, 96, 1>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;    // one
        case 128: launch_dpas<K, CB, 128, 1>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;  // decode pass for 65-128 rows
#endif
    }
    return false;
}

#ifndef EXL3_DPAS24_NT
#define EXL3_DPAS24_NT 2
#endif
static int dpas_nt(int MB) { return MB >= 96 ? 1 : MB == 4 ? EXL3_DPAS4_NT : MB == 8 ? EXL3_DPAS8_NT : MB == 24 ? EXL3_DPAS24_NT : MB == 40 ? EXL3_DPAS40_NT : MB == 48 ? EXL3_DPAS48_NT : (MB <= 16 ? 4 : (MB == 32 ? EXL3_DPAS32_NT : EXL3_DPAS64_NT)); }
static int g_vec_max_m = 2;   // vector kernel for M<=2, DPAS (flat cost up to M=8) above

// Split-K sizing: threads to aim for when choosing the number of K splits. Measured on B70 (all linears,
// graph-captured): 1024 beats 4096 by 10-20% for M=1..32 (fewer fp32 partials for had_out to reduce, and the
// 256-GRF DPAS kernels only hold ~1024 resident threads); MB=64 prefers 2048 (77 vs 88 ms).
static int g_target_threads = 1024;          // vector GEMV (M<=2) and DPAS MB=32
static int g_target_threads_mb16 = 1408;     // DPAS MB=8/16: plateau 1280-1536 (M=4 35.1->32.2 ms, M=16 38.7->36.0), cliff at 1664
static int g_target_threads_mb64 = 2048;
static int g_wave_cap = 0;                  // 0 = off; else choose P = floor(cap / units) (see exl3_gemm_small)

// Column-strip width (tiles per thread) per case, from bench sweeps on B70:
// K=4 M=1 -> 8 (longer contiguous reads), K=4 M=2..4 -> 4, K=6 -> 4 (two 32-lane tile pairs), M=8 -> 2.
constexpr int nt_of(int K, int MR) { return MR == 8 ? ((K & 1) ? 4 : 2) : (K <= 4 ? (MR == 1 ? 8 : 4) : 4); }
static int nt_for(int K, int MR) { return nt_of(K, MR); }

template <int K, int CB>
static bool dispatch_mr(int MR, const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard,
                        at::Tensor& part, int M, int Kdim, int N, int P, int rps, sycl::queue& q) {
    switch (MR) {
        case 1: launch_gemv<K, CB, 1, nt_of(K, 1)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
        case 2: launch_gemv<K, CB, 2, nt_of(K, 2)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
        case 4: launch_gemv<K, CB, 4, nt_of(K, 4)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
        case 8: launch_gemv<K, CB, 8, nt_of(K, 8)>(xh, tr, shard, part, M, Kdim, N, P, rps, q); return true;
    }
    return false;
}

// ---- fused single-kernel path (M <= 8, fp16 in/out): input Hadamard + GEMM + split-K + output Hadamard
static at::Tensor& fused_counters(const at::Device& dev) {
    static std::vector<at::Tensor> bufs(16);
    auto& b = bufs.at(dev.index());
    if (!b.defined()) b = at::zeros({1 << 16}, at::TensorOptions().dtype(at::kInt).device(dev));
    return b;
}

template <typename KernelT>
static void launch_fused(KernelT k, int n, sycl::queue& q) {
    int local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

template <int K, int CB>
static bool fused_small(const at::Tensor& x, const at::Tensor& tr, const at::Tensor& suh, const at::Tensor& svh,
                        const at::Tensor& shard, at::Tensor& out, int M, int Kdim, int N, sycl::queue& q) {
    int tk = Kdim / 16, tiles_n = N / 16;
    bool vec = M <= g_vec_max_m;
    int NT = vec ? (M <= 1 ? nt_of(K, 1) : nt_of(K, 2)) : dpas_nt(8);
    int n_strips = tiles_n / NT;
    int P = std::max(1, std::min(tk / 8, (g_target_threads + n_strips - 1) / n_strips));
    int rps = ((tk + P - 1) / P + 7) / 8 * 8;             // multiple of 8 tile-rows (one Hadamard block)
    P = (tk + rps - 1) / rps;
    auto part = at::empty({P, M, N}, x.options().dtype(at::kFloat));
    FusedArgs fa{reinterpret_cast<const fp16*>(x.data_ptr()), (int)x.stride(0),
                 reinterpret_cast<const fp16*>(suh.data_ptr()), reinterpret_cast<const fp16*>(svh.data_ptr()),
                 reinterpret_cast<fp16*>(out.data_ptr()), (int)out.stride(0),
                 reinterpret_cast<uint32_t*>(fused_counters(x.device()).data_ptr())};
    const uint32_t* trp = reinterpret_cast<const uint32_t*>(tr.data_ptr());
    const int* shp = shard.data_ptr<int>();
    float* pp = part.data_ptr<float>();
    int n = n_strips * P;
    if (vec) {
        if (M <= 1) {
            GemvKernel<K, CB, 1, nt_of(K, 1), true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, fa, P};
#ifdef EXL3_LUT
            k.lut = lut_for(CB, x, q);
#endif
            launch_fused(k, n, q);
        } else {
            GemvKernel<K, CB, 2, nt_of(K, 2), true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, fa, P};
#ifdef EXL3_LUT
            k.lut = lut_for(CB, x, q);
#endif
            launch_fused(k, n, q);
        }
    } else {
        DpasKernel<K, CB, 8, EXL3_DPAS8_NT, true> k{nullptr, trp, shp, pp, M, Kdim, N, tiles_n, rps, n_strips, 1, 8, fa, P};
        launch_fused(k, n, q);
    }
    return true;
}

// Input-Hadamard-only fusion: the DPAS kernel computes xh for its own 128-row blocks (no HadIn launch);
// split-K partials still go through HadOutKernel, split sizing as the unfused MB=8 path (target mb16).
static bool g_fused_in = false;
void exl3_set_fused_in(int64_t on) { g_fused_in = on != 0; }
template <int K, int CB>
static void fused_in_small(const at::Tensor& x, const at::Tensor& tr, const at::Tensor& suh, const at::Tensor& svh,
                           const at::Tensor& shard, at::Tensor& out, int M, int Kdim, int N, sycl::queue& q);

static bool g_fused = false;   // measured slower under XPU graphs (serialized split-K tail); opt in via exl3_set_fused
void exl3_set_fused(int64_t on) { g_fused = on != 0; }

template <int K, int CB>
static void fused_in_small(const at::Tensor& x, const at::Tensor& tr, const at::Tensor& suh, const at::Tensor& svh,
                           const at::Tensor& shard, at::Tensor& out, int M, int Kdim, int N, sycl::queue& q) {
    int tk = Kdim / 16, tiles_n = N / 16;
    constexpr int NT = EXL3_DPAS8_NT;
    int n_strips = tiles_n / NT;
    int P = std::max(1, std::min(tk / 8, (g_target_threads_mb16 + n_strips - 1) / n_strips));
    int rps = ((tk + P - 1) / P + 7) / 8 * 8;             // whole 128-row Hadamard blocks per split
    P = (tk + rps - 1) / rps;
    auto part = at::empty({P, M, N}, x.options().dtype(at::kFloat));
    FusedArgs fa{reinterpret_cast<const fp16*>(x.data_ptr()), (int)x.stride(0),
                 reinterpret_cast<const fp16*>(suh.data_ptr()), nullptr, nullptr, 0, nullptr};
    DpasKernel<K, CB, 8, NT, true, true> k{nullptr, reinterpret_cast<const uint32_t*>(tr.data_ptr()), shard.data_ptr<int>(),
                                           part.data_ptr<float>(), M, Kdim, N, tiles_n, rps, n_strips, 1, 8, fa, P};
    launch_fused(k, n_strips * P, q);
    if (out.scalar_type() == at::kHalf) launch_had_out<fp16>(part, P, svh, out, q);
    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16>(part, P, svh, out, q);
    else launch_had_out<float>(part, P, svh, out, q);
}

#include <unordered_map>
static std::unordered_map<int64_t, int> g_shape_p;   // (N, Kdim, MB or -MR) -> split-K count P
static int64_t shape_key(int64_t N, int64_t Kdim, int64_t mb) { return (N << 32) ^ (Kdim << 8) ^ (mb & 0xFF); }
void exl3_set_shape_p(int64_t N, int64_t Kdim, int64_t mb, int64_t P) {
    if (P <= 0) g_shape_p.erase(shape_key(N, Kdim, mb)); else g_shape_p[shape_key(N, Kdim, mb)] = (int)P; }
void exl3_clear_shape_p() { g_shape_p.clear(); }
static std::unordered_map<int64_t, int> g_shape_nt;  // (N, Kdim, MB) -> NT override (1) for MB24/32
void exl3_set_shape_nt(int64_t N, int64_t Kdim, int64_t mb, int64_t nt) {
    if (nt <= 0) g_shape_nt.erase(shape_key(N, Kdim, mb)); else g_shape_nt[shape_key(N, Kdim, mb)] = (int)nt; }
static int g_stage_mask = 7;   // probe: bit0 HadIn, bit1 GEMM, bit2 HadOut (timing only; 7 = normal)
void exl3_set_stage_mask(int64_t m) { g_stage_mask = (int)m; }
struct NoopKernel { float* p; void operator()(sycl::nd_item<1> it) const { if (it.get_global_id(0) == (size_t)-1) p[0] = 0; } };
void exl3_noop(at::Tensor t, int64_t n, int64_t items) {
    auto& q = queue_of(t); float* p = t.data_ptr<float>();
    for (int64_t i = 0; i < n; ++i) q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(items, 16), NoopKernel{p}); });
}

void exl3_gemm_small(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
                     at::Tensor out, int64_t K, int64_t cb) {
    TORCH_CHECK(x.dim() == 2 && x.stride(1) == 1, "x must be 2D row-major");
    TORCH_CHECK(trellis.scalar_type() == at::kShort && trellis.is_contiguous());
    auto& q = queue_of(x);
    int M = x.size(0), Kdim = x.size(1), N = svh.size(0), S = suh.size(0);
    if (g_fused && M <= 8 && x.scalar_type() == at::kHalf && out.scalar_type() == at::kHalf && out.stride(1) == 1 &&
        N / 128 <= (1 << 16)) {
        bool done = false;
        if (K == 4 && cb == 2) done = fused_small<4, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q);
        else if (K == 6 && cb == 2) done = fused_small<6, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q);
        if (done) return;
    }
    if (g_fused_in && M > g_vec_max_m && M <= 8 && x.scalar_type() == at::kHalf) {
        if (K == 4 && cb == 2) { fused_in_small<4, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q); return; }
        if (K == 6 && cb == 2) { fused_in_small<6, 2>(x, trellis, suh, svh, shard_of_nb, out, M, Kdim, N, q); return; }
    }
    bool use_vec = M <= g_vec_max_m;
    int MR = M <= 1 ? 1 : (M <= 2 ? 2 : (M <= 4 ? 4 : 8));
#ifdef EXL3_DPAS_MB4
    int MB = M <= 4 ? 4 : (M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64)));
#elif defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
#ifdef EXL3_K5_MB128
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : (M <= 64 ? 64 : (M <= 96 ? 96 : 128)))))));
#else
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
#endif
#elif defined(EXL3_DPAS_MB24)
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
#else
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
#endif
    if (MB > g_max_mb) MB = g_max_mb;
    int m_blocks = use_vec ? 1 : (M + MB - 1) / MB;
    int Mp = use_vec ? M : m_blocks * MB;
    // blocked activations [S][Mp][Kdim] (row-blocked inside); pad rows must be zero for DPAS
    auto xh = at::empty({S, Mp, Kdim}, x.options().dtype(at::kHalf));   // pad rows zeroed by HadInKernel
    if (!(g_stage_mask & 1)) ;
    else if (x.scalar_type() == at::kHalf) launch_had_in<fp16>(x, suh, xh, q);
    else if (x.scalar_type() == at::kBFloat16) launch_had_in<sycl::ext::oneapi::bfloat16>(x, suh, xh, q);
    else TORCH_CHECK(false, "x dtype");

    int tk = Kdim / 16;
    g_cur_nt = 0;
    if (!use_vec && (MB == 24 || MB == 32)) {
        auto it = g_shape_nt.find(shape_key(N, Kdim, MB));
        if (it != g_shape_nt.end()) g_cur_nt = it->second;
    }
    int n_strips = (N / 16) / (use_vec ? nt_for(K, MR) : (g_cur_nt == 1 ? 1 : dpas_nt(MB)));
    int units = n_strips * m_blocks;
    int target = use_vec ? g_target_threads
               : (MB <= 16 ? g_target_threads_mb16 : (MB >= 40 ? g_target_threads_mb64 : g_target_threads));
    int P = std::max(1, std::min(tk, (target + units - 1) / units));
    // wave cap: the largest split count whose threads still fit one resident wave (B70: 2048 = 32 Xe x 8 XVE x 8
    // threads at 128 GRF). Rounding the target up past the cap leaves a partial second wave (gate_up 504 -> 342 GB/s).
    if (g_wave_cap > 0 && (use_vec || MB <= 16)) P = std::max(1, std::min(tk, g_wave_cap / units));
    {   // per-shape split-K count (tuned table; wave quantization differs per shape)
        auto it = g_shape_p.find(shape_key(N, Kdim, use_vec ? -MR : MB));
        if (it != g_shape_p.end()) P = std::max(1, std::min(tk, it->second));
    }
    int rps = (tk + P - 1) / P;
    P = (tk + rps - 1) / rps;
    auto part = at::empty({P, M, N}, x.options().dtype(at::kFloat));

    bool ok = false;
#ifdef EXL3_DEBUG_SKIP_GEMV
    ok = true; K = -1;
#endif
    if (!(g_stage_mask & 2)) { ok = true; K = -1; }
#define EXL3_CASE(KK, CC) \
    if (K == KK && cb == CC) ok = use_vec ? dispatch_mr<KK, CC>(MR, xh, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q) \
                                          : dispatch_dpas<KK, CC>(MB, xh, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
    EXL3_CASE(4, 2) EXL3_CASE(6, 2)
#ifdef EXL3_ALL_CODEBOOKS
    EXL3_CASE(2, 2) EXL3_CASE(3, 2) EXL3_CASE(5, 2)
    EXL3_CASE(4, 0) EXL3_CASE(4, 1) EXL3_CASE(6, 0) EXL3_CASE(6, 1)
#endif
#undef EXL3_CASE
    TORCH_CHECK(ok, "exl3_gemm_small: unsupported K/codebook ", K, "/", cb);

    if (!(g_stage_mask & 4)) return;
    if (out.scalar_type() == at::kHalf) launch_had_out<fp16>(part, P, svh, out, q);
    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16>(part, P, svh, out, q);
    else if (out.scalar_type() == at::kFloat) launch_had_out<float>(part, P, svh, out, q);
    else TORCH_CHECK(false, "out dtype");
}


template <int K, int CB>
static void launch_reconstruct(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q) {
    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
    constexpr int NT = 8;   // 128 columns per thread (reconstruct slices are multiples of 128)
    int n_strips = n_out / (16 * NT);
    ReconstructKernel<K, CB, NT> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
                                   reinterpret_cast<fp16*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk};
    int n = n_strips * tk, local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

#ifdef EXL3_DNNL
#include <oneapi/dnnl/dnnl.hpp>
#include <oneapi/dnnl/dnnl_sycl.hpp>
// y[:, cols] (fp16, row stride ldy) = (xq[M,K] @ wq[K,N]) * sw * sx[m]: int8 XMX GEMM with the dequant fused,
// so the output Hadamard reads fp16 instead of int32. Primitives cached per (M, K, N, ldy).
namespace q8dnnl {
struct Ctx { dnnl::engine eng; dnnl::stream strm; };
static Ctx& ctx(sycl::queue& q) {
    static std::map<void*, Ctx> m;
    void* key = (void*)&q;
    auto it = m.find(key);
    if (it == m.end()) {
        auto eng = dnnl::sycl_interop::make_engine(q.get_device(), q.get_context());
        it = m.emplace(key, Ctx{eng, dnnl::sycl_interop::make_stream(eng, q)}).first;
    }
    return it->second;
}
static void gemm(sycl::queue& q, const at::Tensor& like, const int8_t* xq, const int8_t* wq, const float* sw_dev, const float* sx, fp16* y,
                   int64_t M, int64_t K, int64_t N, int64_t ldy, bool per_n = false) {
    using namespace dnnl;
    using dt = memory::data_type;
    auto& c = ctx(q);
    // scratchpad in user mode, allocated through torch (library-mode scratch lives outside vLLM's memory budget)
    static std::map<std::tuple<int64_t, int64_t, int64_t, int64_t, bool>, std::pair<dnnl::matmul, size_t>> cache;
    auto key = std::make_tuple(M, K, N, ldy, per_n);
    memory::desc a_md({M, K}, dt::s8, memory::dims{K, 1});
    memory::desc b_md({K, N}, dt::s8, memory::dims{N, 1});
    memory::desc c_md({M, N}, dt::f16, memory::dims{ldy, 1});
    memory::desc sx_md({M, 1}, dt::f32, memory::dims{1, 1});
    memory::desc sw_md({per_n ? N : 1}, dt::f32, memory::dims{1});   // per_n: per-output-column weight scales
    auto it = cache.find(key);
    if (it == cache.end()) {
        primitive_attr attr;
        attr.set_scales_mask(DNNL_ARG_WEIGHTS, per_n ? (1 << 1) : 0);
        post_ops po;
        po.append_binary(algorithm::binary_mul, sx_md);
        attr.set_post_ops(po);
        attr.set_scratchpad_mode(scratchpad_mode::user);
        auto pd = dnnl::matmul::primitive_desc(c.eng, a_md, b_md, c_md, attr);
        it = cache.emplace(key, std::make_pair(dnnl::matmul(pd), (size_t)pd.scratchpad_desc().get_size())).first;
    }
    at::Tensor scratch = at::empty({(int64_t)std::max<size_t>(it->second.second, 1)}, like.options().dtype(at::kByte));
    auto mk = [&](const memory::desc& md, const void* p) {
        return sycl_interop::make_memory(md, c.eng, sycl_interop::memory_kind::usm, const_cast<void*>(p));
    };
    memory::desc sp_md({(int64_t)it->second.second}, dt::u8, memory::dims{1});
    sycl_interop::execute(it->second.first, c.strm,
                          {{DNNL_ARG_SRC, mk(a_md, xq)}, {DNNL_ARG_WEIGHTS, mk(b_md, wq)}, {DNNL_ARG_DST, mk(c_md, y)},
                           {DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, mk(sw_md, sw_dev)},
                           {DNNL_ARG_ATTR_MULTIPLE_POST_OP(0) | DNNL_ARG_SRC_1, mk(sx_md, sx)},
                           {DNNL_ARG_SCRATCHPAD, mk(sp_md, scratch.data_ptr())}});
}
}  // namespace q8dnnl
#endif

#ifdef EXL3_DNNL
#include <oneapi/dnnl/dnnl_graph.hpp>
#include <oneapi/dnnl/dnnl_graph_sycl.hpp>
#include <c10/xpu/XPUCachingAllocator.h>
// Prefill attention through oneDNN Graph SDPA (fused, ~95 TF at head_dim 256 vs ~76 for FA2).
// Head-major: q [Hq, Q, D], k/v [Hk, L, D] fp16 (GQA, Hq = G*Hk), out [Hq, Q, D]; causal = bottom-right aligned.
// With lse defined ([Hq, Q] f32), the softmax log-sum-exp (natural log) is written there (softmax stats output).
namespace sdpadnnl {
using namespace dnnl::graph;
using lt = logical_tensor;
static void* alloc_fn(size_t n, size_t, const void*, const void*) { return c10::xpu::XPUCachingAllocator::raw_alloc(n); }
static void free_fn(void* p, const void*, const void*, void*) { c10::xpu::XPUCachingAllocator::raw_delete(p); }
struct Ctx { dnnl::engine eng; dnnl::stream strm; };
static Ctx& ctx(sycl::queue& q) {
    static std::map<void*, Ctx> m;
    auto it = m.find((void*)&q);
    if (it == m.end()) {
        auto alloc = sycl_interop::make_allocator(alloc_fn, free_fn);
        auto eng = sycl_interop::make_engine_with_allocator(q.get_device(), q.get_context(), alloc);
        it = m.emplace((void*)&q, Ctx{eng, dnnl::sycl_interop::make_stream(eng, q)}).first;
    }
    return it->second;
}
struct Entry { compiled_partition cp; std::vector<lt> ins, outs; };
static Entry& build(Ctx& c, int64_t Q, int64_t L, int64_t Hq, int64_t Hk, int64_t D, bool causal, bool with_lse) {
    static std::map<std::tuple<int64_t, int64_t, int64_t, int64_t, int64_t, bool, bool>, Entry> cache;
    auto key = std::make_tuple(Q, L, Hq, Hk, D, causal, with_lse);
    auto it = cache.find(key);
    if (it != cache.end()) return it->second;
    const int64_t G = Hq / Hk;
    using dt = lt::data_type;
    size_t id = 0;
    // 5D views of the natural vLLM layouts (no copies): [1, Hk, G, Q, D] / [1, Hk, 1, L, D]
    lt query(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
    lt keyt(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
    lt score(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
    op bmm1(id++, op::kind::MatMul, "bmm1"); bmm1.set_attr<bool>(op::attr::transpose_b, true);
    bmm1.add_inputs({query, keyt}); bmm1.add_outputs({score});
    lt scale(id++, dt::f16, lt::dims{1}, lt::layout_type::strided);   // divisor sqrt(D), as in oneDNN's gqa example
    lt scaled(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
    op mul(id++, op::kind::Divide, "scale"); mul.add_inputs({score, scale}); mul.add_outputs({scaled});
    std::vector<op> ops{bmm1, mul};
    lt sm_in = scaled;
    std::vector<lt> extra_ins;
    if (causal) {
        lt row(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op gr(id++, op::kind::GenIndex, "row"); gr.set_attr<int64_t>(op::attr::axis, -2); gr.add_inputs({scaled}); gr.add_outputs({row});
        lt lk(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
        lt ra(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op add(id++, op::kind::Add, "row+L"); add.add_inputs({row, lk}); add.add_outputs({ra});
        lt lq(id++, dt::s32, 0, lt::layout_type::strided, lt::property_type::host_scalar);
        lt rs(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op sub(id++, op::kind::Subtract, "-Q"); sub.add_inputs({ra, lq}); sub.add_outputs({rs});
        lt col(id++, dt::s32, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op gc(id++, op::kind::GenIndex, "col"); gc.set_attr<int64_t>(op::attr::axis, -1); gc.add_inputs({scaled}); gc.add_outputs({col});
        lt ge(id++, dt::boolean, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op gop(id++, op::kind::GreaterEqual, "ge"); gop.add_inputs({rs, col}); gop.add_outputs({ge});
        lt ninf(id++, dt::f32, lt::dims{1}, lt::layout_type::strided);
        lt masked(id++, dt::f32, {1, Hk, G, Q, L}, lt::layout_type::strided);
        op sel(id++, op::kind::Select, "sel"); sel.add_inputs({ge, scaled, ninf}); sel.add_outputs({masked});
        ops.insert(ops.end(), {gr, add, sub, gc, gop, sel});
        extra_ins = {lk, lq, ninf};
        sm_in = masked;
    }
    lt probs(id++, dt::f16, {1, Hk, G, Q, L}, lt::layout_type::strided);
    op sm(id++, op::kind::SoftMax, "softmax"); sm.set_attr<int64_t>(op::attr::axis, -1);
    sm.set_attr<std::string>(op::attr::mode, "inf_as_zero");
    sm.add_inputs({sm_in}); 
    lt stats(id++, dt::f32, {1, Hk, G, Q, 1}, {Hq * Q, G * Q, Q, 1, 1});
    if (with_lse) sm.add_outputs({probs, stats}); else sm.add_outputs({probs});
    lt value(id++, dt::f16, {1, Hk, 1, L, D}, {Hk * L * D, L * D, L * D, D, 1});
    lt output(id++, dt::f16, {1, Hk, G, Q, D}, {Hq * Q * D, G * Q * D, Q * D, D, 1});
    op bmm2(id++, op::kind::MatMul, "bmm2"); bmm2.add_inputs({probs, value}); bmm2.add_outputs({output});
    ops.insert(ops.end(), {sm, bmm2});
    graph g(dnnl::engine::kind::gpu);
    for (auto& o : ops) g.add_op(o);
    g.finalize();
    auto parts = g.get_partitions();
    TORCH_CHECK(parts.size() == 1, "oneDNN SDPA: pattern not fused (", parts.size(), " partitions)");
    std::vector<lt> ins{query, keyt, scale};
    ins.insert(ins.end(), extra_ins.begin(), extra_ins.end());
    ins.push_back(value);
    std::vector<lt> outs{output};
    if (with_lse) outs.push_back(stats);
    auto cp = parts[0].compile(ins, outs, c.eng);
    return cache.emplace(key, Entry{cp, ins, outs}).first->second;
}
}  // namespace sdpadnnl

static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
                      int64_t len_k, int64_t len_q);
void exl3_sdpa(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
    sdpa_impl(q, k, v, out, lse, causal, scale, k.size(1), q.size(1));
}
// Padded dims, real lengths for the bottom-right mask: keys >= len_k are masked for every row.
void exl3_sdpa_len(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
                   int64_t len_k, int64_t len_q) {
    TORCH_CHECK(causal, "exl3_sdpa_len: causal only");
    sdpa_impl(q, k, v, out, lse, causal, scale, len_k, len_q);
}
static void sdpa_impl(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale,
                      int64_t len_k, int64_t len_q) {
    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous());
    int64_t Hq = q.size(0), Q = q.size(1), D = q.size(2), Hk = k.size(0), L = k.size(1);
    auto& qq = queue_of(q);
    auto& c = sdpadnnl::ctx(qq);
    bool with_lse = lse.defined() && lse.numel() > 0;
    auto& e = sdpadnnl::build(c, Q, L, Hq, Hk, D, causal, with_lse);
    using dnnl::graph::tensor;
    static std::vector<at::Tensor> sc(16), ni(16);
    auto& st = sc.at(q.device().index());
    if (!st.defined() || std::abs(st.item<float>() - (float)(1.0 / scale)) > 1e-3f) st = at::full({1}, (float)(1.0 / scale), q.options().dtype(at::kHalf));
    auto& nt = ni.at(q.device().index());
    if (!nt.defined()) nt = at::full({1}, -std::numeric_limits<float>::infinity(), q.options().dtype(at::kFloat));
    int32_t lk = (int32_t)len_k, lq = (int32_t)len_q;
    std::vector<tensor> ins{tensor(e.ins[0], c.eng, q.data_ptr()), tensor(e.ins[1], c.eng, k.data_ptr()),
                            tensor(e.ins[2], c.eng, st.data_ptr())};
    size_t vi = 3;
    if (causal) {
        ins.push_back(tensor::make_scalar_tensor(e.ins[3], &lk));
        ins.push_back(tensor::make_scalar_tensor(e.ins[4], &lq));
        ins.push_back(tensor(e.ins[5], c.eng, nt.data_ptr()));
        vi = 6;
    }
    ins.push_back(tensor(e.ins[vi], c.eng, v.data_ptr()));
    std::vector<tensor> outs{tensor(e.outs[0], c.eng, out.data_ptr())};
    if (with_lse) outs.push_back(tensor(e.outs[1], c.eng, lse.data_ptr()));
    dnnl::graph::sycl_interop::execute(e.cp, c.strm, ins, outs);
}
#endif

// W8A8 prefill (opt-in): mul1 codebook values are bounded by 3.453125, one static int8 scale for every tensor
static bool g_int8 = false;
void exl3_set_int8(int64_t on) { g_int8 = on != 0; }
constexpr float kQ8WMax = 3.453125f;

template <int K>
static void launch_reconstruct_q8(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q) {
    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
    constexpr int NT = 8;
    int n_strips = n_out / (16 * NT);
    ReconstructKernel<K, 2, NT, int8_t> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
                                          reinterpret_cast<int8_t*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk,
                                          127.0f / kQ8WMax};
    int n = n_strips * tk, local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}

// output Hadamard folded into the int8 weights. Per layer, once: W' = H128_N(W_inner)/sqrt(128),
// per-output-column int8 scales amax_n/127 (fixed-scale folding clips, per-column keeps today's error); the GEMM's per-column
// weight scale amax_n/127 * svh[n] then yields the final output directly (no had_out pass). Toggle exl3_set_q8_fold.
static bool g_q8_fold = false;   // off: +0.3% end to end only (A/B); exl3_set_q8_fold(1) or EXL3_Q8_FOLD_MIN_M to test
// the fold moves the transform onto the weights (per chunk): pays off only at large M; env EXL3_Q8_FOLD_MIN_M overrides
static int64_t g_q8_fold_min_m = std::getenv("EXL3_Q8_FOLD_MIN_M") ? std::atoll(std::getenv("EXL3_Q8_FOLD_MIN_M")) : 2048;
static bool g_q8_fold_env = std::getenv("EXL3_Q8_FOLD_MIN_M") && (g_q8_fold = true);   // env set -> fold on
void exl3_set_q8_fold(int64_t on) { g_q8_fold = on != 0; if (on > 1) g_q8_fold_min_m = on; }
template <int K>
static void launch_reconstruct_q8_fold(const at::Tensor& tr, at::Tensor& w, int n0, const float* qinv, sycl::queue& q) {
    int tk = tr.size(0), tiles_n = tr.size(1), n_out = w.size(1);
    constexpr int NT = 8;
    int n_strips = n_out / (16 * NT);
    ReconstructKernel<K, 2, NT, int8_t, true> k{reinterpret_cast<const uint32_t*>(tr.data_ptr()),
                                                reinterpret_cast<int8_t*>(w.data_ptr()), tiles_n, n0 / 16, n_out, n_strips, tk,
                                                0.0f, qinv};
    int n = n_strips * tk, local = 8;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, local), local), k); });
}
template <int K, int CB> static void launch_reconstruct(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q);
// (qinv [n] = 127/amax_n, deq [n] = amax_n/127 * svh[n]), cached per trellis tensor
static std::pair<at::Tensor, at::Tensor>& fold_scales(const at::Tensor& tr, const at::Tensor& svh, int64_t K, sycl::queue& q) {
    static std::map<const void*, std::pair<at::Tensor, at::Tensor>> cache;
    auto it = cache.find(tr.data_ptr());
    if (it != cache.end()) return it->second;
    const int64_t k = tr.size(0) * 16, n = tr.size(1) * 16;
    static std::vector<at::Tensor> hmat(16);
    auto& H = hmat.at(tr.device().index());
    if (!H.defined()) {
        auto h = at::ones({1, 1}, tr.options().dtype(at::kFloat));
        while (h.size(0) < 128) h = at::cat({at::cat({h, h}, 1), at::cat({h, -h}, 1)}, 0);
        H = h / std::sqrt(128.0f);
    }
    auto amax = at::empty({n}, tr.options().dtype(at::kFloat));
    const int64_t SL = 2048;   // column slices bound the one-time fp16/fp32 temporaries
    for (int64_t c0 = 0; c0 < n; c0 += SL) {
        int64_t c1 = std::min(c0 + SL, n);
        auto w = at::empty({k, c1 - c0}, tr.options().dtype(at::kHalf));
        if (K == 4) launch_reconstruct<4, 2>(tr, w, (int)c0, q); else launch_reconstruct<6, 2>(tr, w, (int)c0, q);
        auto wf = at::matmul(w.to(at::kFloat).view({k, (c1 - c0) / 128, 128}), H).view({k, c1 - c0});
        amax.narrow(0, c0, c1 - c0).copy_(std::get<0>(wf.abs().max(0)).clamp_min(1e-8f));
    }
    auto qinv = (127.0f / amax).contiguous();
    auto deq = (amax / 127.0f * svh.to(at::kFloat)).contiguous();
    return cache.emplace(tr.data_ptr(), std::make_pair(qinv, deq)).first->second;
}

void exl3_reconstruct(at::Tensor trellis, at::Tensor w, int64_t n0, int64_t K, int64_t cb) {
    TORCH_CHECK(w.scalar_type() == at::kHalf && w.is_contiguous() && w.size(1) % 128 == 0 && n0 % 128 == 0);
    TORCH_CHECK(w.size(0) == trellis.size(0) * 16 && n0 + w.size(1) <= trellis.size(1) * 16);
    auto& q = queue_of(w);
    bool ok = true;
    if (K == 4 && cb == 2) launch_reconstruct<4, 2>(trellis, w, n0, q);
    else if (K == 6 && cb == 2) launch_reconstruct<6, 2>(trellis, w, n0, q);
#ifdef EXL3_ALL_CODEBOOKS
    else if (K == 2 && cb == 2) launch_reconstruct<2, 2>(trellis, w, n0, q);
    else if (K == 3 && cb == 2) launch_reconstruct<3, 2>(trellis, w, n0, q);
    else if (K == 5 && cb == 2) launch_reconstruct<5, 2>(trellis, w, n0, q);
    else if (K == 4 && cb == 1) launch_reconstruct<4, 1>(trellis, w, n0, q);
    else if (K == 4 && cb == 0) launch_reconstruct<4, 0>(trellis, w, n0, q);
#endif
    else ok = false;
    TORCH_CHECK(ok, "exl3_reconstruct: unsupported K/cb");
}

// Debug/verification: part = xh_blocked @ W_inner via a forced path (0 = vector, 1 = DPAS), summed over splits.
at::Tensor exl3_gemm_raw(at::Tensor xh_blocked, at::Tensor trellis, at::Tensor shard_of_nb, int64_t N, int64_t K,
                         int64_t cb, int64_t path) {
    auto& q = queue_of(xh_blocked);
    int S = xh_blocked.size(0), Kdim = xh_blocked.size(1) * 16, M = xh_blocked.size(2);
    bool use_vec = path == 0;
    if (!use_vec) {
#if defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
#elif defined(EXL3_DPAS_MB24)
        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
#else
        int MBp = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
#endif
        int Mp = (M + MBp - 1) / MBp * MBp;
        if (Mp != M) xh_blocked = at::constant_pad_nd(xh_blocked, {0, 0, 0, Mp - M}).contiguous();
    }
    int MR = M <= 1 ? 1 : (M <= 2 ? 2 : (M <= 4 ? 4 : 8));
#ifdef EXL3_DPAS_MB4
    int MB = M <= 4 ? 4 : (M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64)));
#elif defined(EXL3_DPAS_MB24) && defined(EXL3_DPAS_MB48)
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : (M <= 40 ? 40 : (M <= 48 ? 48 : 64)))));
#elif defined(EXL3_DPAS_MB24)
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 24 ? 24 : (M <= 32 ? 32 : 64)));
#else
    int MB = M <= 8 ? 8 : (M <= 16 ? 16 : (M <= 32 ? 32 : 64));
#endif
    int tk = Kdim / 16;
    int P = 4, rps = (tk + P - 1) / P; P = (tk + rps - 1) / rps;
    auto part = at::zeros({P, M, N}, xh_blocked.options().dtype(at::kFloat));
    bool ok = false;
    if (K == 4 && cb == 2) ok = use_vec ? dispatch_mr<4, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
                                        : dispatch_dpas<4, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
    if (K == 6 && cb == 2) ok = use_vec ? dispatch_mr<6, 2>(MR, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q)
                                        : dispatch_dpas<6, 2>(MB, xh_blocked, trellis, shard_of_nb, part, M, Kdim, N, P, rps, q);
    TORCH_CHECK(ok);
    (void)S;
    return part.sum(0);
}

// Prefill helpers: row-major input Hadamard (GEMM operand) and fp16 output Hadamard.
void exl3_had_in_rm(at::Tensor x, at::Tensor suh, at::Tensor xh) {
    TORCH_CHECK(xh.scalar_type() == at::kHalf && xh.is_contiguous() && xh.size(1) == x.size(0));
    auto& q = queue_of(x);
    if (x.scalar_type() == at::kHalf) launch_had_in<fp16>(x, suh, xh, q, true);
    else if (x.scalar_type() == at::kBFloat16) launch_had_in<sycl::ext::oneapi::bfloat16>(x, suh, xh, q, true);
    else TORCH_CHECK(false, "x dtype");
}

void exl3_had_out_h(at::Tensor y, at::Tensor svh, at::Tensor out) {
    TORCH_CHECK(y.scalar_type() == at::kHalf && y.is_contiguous() && y.sizes() == out.sizes());
    auto& q = queue_of(y);
    if (out.scalar_type() == at::kHalf) launch_had_out<fp16, fp16>(y, 1, svh, out, q);
    else if (out.scalar_type() == at::kBFloat16) launch_had_out<sycl::ext::oneapi::bfloat16, fp16>(y, 1, svh, out, q);
    else TORCH_CHECK(false, "out dtype");
}

// ---- flash-attention forward (prefill), fp16, head_dim 256, GQA; returns O and natural-log LSE
void exl3_fa_fwd(at::Tensor q, at::Tensor k, at::Tensor v, at::Tensor out, at::Tensor lse, bool causal, double scale) {
    TORCH_CHECK(q.scalar_type() == at::kHalf && k.scalar_type() == at::kHalf && v.scalar_type() == at::kHalf);
    TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() && out.is_contiguous() && lse.is_contiguous());
    TORCH_CHECK(q.size(2) == 256 && k.size(2) == 256, "head_dim 256 only");
    int Lq = q.size(0), Hq = q.size(1), Lk = k.size(0), Hk = k.size(1);
    TORCH_CHECK(Hq % Hk == 0);
    int G = Hq / Hk;
    auto& qq = queue_of(q);
    exl3fa::FaKernel kern{reinterpret_cast<const sycl::half*>(q.data_ptr()), reinterpret_cast<const sycl::half*>(k.data_ptr()),
                          reinterpret_cast<const sycl::half*>(v.data_ptr()), reinterpret_cast<sycl::half*>(out.data_ptr()),
                          lse.data_ptr<float>(), Lq, Lk, Hq, Hk, G, (float)(scale * 1.4426950408889634), causal ? 1 : 0};
    int qtiles = (Lq + exl3fa::QR - 1) / exl3fa::QR;
    int n = qtiles * Hk * G;
    sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
    qq.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(n, G), props, kern); });
}

// ---- speculative-verify decode attention (paged fp16 KV, head_dim 256, q_len <= 8): KV read once per work-group
static void spec_attn_impl(at::Tensor q, at::Tensor k_cache, at::Tensor v_cache, at::Tensor block_table, at::Tensor seqused,
                           at::Tensor out, int64_t q_len, double scale, int64_t splits,
                           std::optional<at::Tensor> k_scale, std::optional<at::Tensor> v_scale,
                           const at::Tensor* qsl, const std::optional<at::Tensor>& rot = std::nullopt) {
    // fp8 (e4m3fn) KV caches supported (k_scale/v_scale: per-tensor float32 device scalars)
    const bool f8 = k_cache.scalar_type() == at::kFloat8_e4m3fn;
    // int8_per_token_head (vLLM Triton layout, NHD): K/V views [blocks, BS, H, 260] int8 with inline f32 scales at byte 256
    const bool i8 = k_cache.scalar_type() == at::kChar;
    // int4_per_token_head: K/V views [blocks, BS, H, 132] uint8 (nibbles + inline f32 scale with zp)
    const bool i4 = k_cache.scalar_type() == at::kByte && k_cache.dim() == 4 && k_cache.size(3) == 132;
    TORCH_CHECK(q.scalar_type() == at::kHalf && k_cache.scalar_type() == v_cache.scalar_type() &&
                (k_cache.scalar_type() == at::kHalf || f8 || i8 || i4), "exl3_spec_attn: fp16 q, fp16 / fp8_e4m3fn / int8 / int4 cache");
    if (i4) {
        TORCH_CHECK(v_cache.size(3) == 132 && k_cache.stride(3) == 1 && k_cache.stride(2) == 264 &&
                    k_cache.stride(1) == k_cache.size(2) * 264 && k_cache.stride(1) % 16 == 0 &&
                    v_cache.stride(0) == k_cache.stride(0) && (char*)v_cache.data_ptr() == (char*)k_cache.data_ptr() + 132 &&
                    k_cache.stride(0) % 64 == 0 && (reinterpret_cast<uintptr_t>(k_cache.data_ptr()) % 64) == 0,
                    "exl3_spec_attn: int4 cache must be vLLM's NHD per-token-head layout");
        TORCH_CHECK(k_cache.size(1) % 32 == 0, "block_size must be a multiple of 32");
    }
    if (i8) {
        TORCH_CHECK(k_cache.dim() == 4 && k_cache.size(3) == 260 && v_cache.size(3) == 260 && k_cache.stride(3) == 1 &&
                    k_cache.stride(2) == 520 && k_cache.stride(1) == k_cache.size(2) * 520 && k_cache.stride(1) % 16 == 0 &&
                    v_cache.stride(0) == k_cache.stride(0) && (char*)v_cache.data_ptr() == (char*)k_cache.data_ptr() + 260 &&
                    k_cache.stride(0) % 64 == 0 && (reinterpret_cast<uintptr_t>(k_cache.data_ptr()) % 64) == 0,
                    "exl3_spec_attn: int8 cache must be vLLM's NHD per-token-head layout");
        TORCH_CHECK(k_cache.size(1) % 32 == 0, "block_size must be a multiple of 32");
    }
    at::Tensor ksc, vsc;
    if (f8) {
        auto one = at::ones({1}, q.options().dtype(at::kFloat));
        ksc = k_scale.has_value() && k_scale->defined() ? k_scale->to(at::kFloat).reshape({-1}).contiguous() : one;
        vsc = v_scale.has_value() && v_scale->defined() ? v_scale->to(at::kFloat).reshape({-1}).contiguous() : one;
    }
    TORCH_CHECK(q.dim() == 3 && q.size(2) == 256 && q.is_contiguous(), "q [T, Hq, 256] contiguous");
    if (!i8 && !i4) {
    TORCH_CHECK(k_cache.dim() == 4 && k_cache.size(3) == 256 && v_cache.sizes() == k_cache.sizes());
    // any [block, token, head, 256] strides that keep 2D block loads legal (64-byte aligned rows/heads/blocks);
    // vLLM XPU interleaves K and V per head: token stride 2048, head stride 512
    TORCH_CHECK(k_cache.stride(1) == v_cache.stride(1) && k_cache.stride(2) == v_cache.stride(2));
    for (auto* c : {&k_cache, &v_cache})
        TORCH_CHECK(c->stride(3) == 1 && c->stride(2) % 32 == 0 && c->stride(1) % 32 == 0 && c->stride(0) % 32 == 0 &&
                    c->stride(2) >= 256 && c->stride(1) >= c->size(2) * c->stride(2) && (c->storage_offset() % 32) == 0,
                    "exl3_spec_attn: unsupported k/v cache strides");
    TORCH_CHECK(k_cache.size(1) % 32 == 0, "block_size must be a multiple of 32");
    }
    TORCH_CHECK(block_table.scalar_type() == at::kInt && seqused.scalar_type() == at::kInt);
    TORCH_CHECK(q_len >= 1 && q_len <= 8);
    TORCH_CHECK(out.scalar_type() == at::kHalf && out.size(-1) == 256 && out.stride(-1) == 1);
    int T = q.size(0), Hq = q.size(1), Hk = k_cache.size(2), BS = k_cache.size(1);
    // varlen (qsl = query_start_loc [B+1], int32, device): B from qsl, q_len = 8 = the partial-buffer row stride;
    // requests with more than 8 rows are skipped (their rows of out are left untouched)
    int B = qsl ? (int)qsl->numel() - 1 : T / q_len;
    if (qsl) { TORCH_CHECK(q_len == 8 && qsl->scalar_type() == at::kInt && qsl->is_contiguous(), "varlen: q_len 8, int32 qsl"); }
    else { TORCH_CHECK(B * q_len == T, "q rows must be B * q_len"); }
    TORCH_CHECK(Hq % Hk == 0 && seqused.size(0) >= B && block_table.size(0) >= B);
    if (B <= 0) return;
    int G = Hq / Hk, S = (int)splits;
    // splits <= 0: one resident wave (256-GRF threads: 32 Xe x 8 XVE x 4 = 1024), fixed per batch size (graph-safe)
    if (S <= 0) S = std::max(4, std::min(64, (1024 + B * Hk * G - 1) / (B * Hk * G)));
    // HEAD-PACK (EXL3_SPEC_HP, default 0): plain decode with q_len * G <= 8
    // packs the G heads into the DPAS rows and splits the keys over the work-group's threads (S * G partials; S capped
    // so S * G <= MERGE_MAX_S). Split count S = max(EXL3_SPEC_HP_MIN, EXL3_SPEC_HP_S / B), fixed per batch size.
    static const int hp_env = [] { const char* e = std::getenv("EXL3_SPEC_HP"); return e ? std::atoi(e) : 0; }();
    static const int hp_s1 = [] { const char* e = std::getenv("EXL3_SPEC_HP_S"); return e ? std::atoi(e) : 8; }();
    static const int hp_min = [] { const char* e = std::getenv("EXL3_SPEC_HP_MIN"); return e ? std::atoi(e) : 1; }();
    // EXL3_SPEC_HP_BMAX (default 1): 27B microbench: HP wins 40-48% at B=1 from 8k on,
    // mixed at B=2..4 with S >= 8 (worse at 36k)
    static const int hp_bmax = [] { const char* e = std::getenv("EXL3_SPEC_HP_BMAX"); return e ? std::atoi(e) : 1; }();
    const bool hp = hp_env && !qsl && G > 1 && q_len * G <= 8 && B <= hp_bmax;
    if (hp) S = std::max(hp_min, hp_s1 / B);
    if (hp && S * G > exl3fa::MERGE_MAX_S) S = exl3fa::MERGE_MAX_S / G;
    const int Sp = hp ? S * G : S;
    auto bt = block_table.is_contiguous() ? block_table : block_table.contiguous();
    auto opart = at::empty({B, Sp, q_len, Hq, 256}, q.options());
    auto lpart = at::empty({B, Sp, q_len, Hq}, q.options().dtype(at::kFloat));
    auto& qq = queue_of(q);
    int n = B * Hk * S * G;
    // rot = vLLM's RHT signs (float32 [256], device): q / output rotated in-kernel
    const float* rsign = nullptr;
    if (rot.has_value() && rot->defined()) {
        TORCH_CHECK(i4 && rot->scalar_type() == at::kFloat && rot->numel() == 256 && rot->is_contiguous(),
                    "exl3_spec_attn: rot = float32 [256] signs, int4 cache only");
        rsign = rot->data_ptr<float>();
    }
    // PREROT (EXL3_I4_PREROT, default 1): rotate q once per call into an fp32 buffer (one 256-item
    // work-group per row and head: signs, SLM butterfly, / 256) instead of once per split thread inside the kernel
    static const int prerot = [] { const char* e = std::getenv("EXL3_I4_PREROT"); return e ? std::atoi(e) : 1; }();
    at::Tensor qrot_t; const float* qrot = nullptr;
    if (rsign && prerot) {
        const int64_t rows = q.size(0) * (int64_t)Hq;
        qrot_t = at::empty({q.size(0), (int64_t)Hq, 256}, q.options().dtype(at::kFloat));
        float* qo = qrot_t.data_ptr<float>();
        const sycl::half* qi = reinterpret_cast<const sycl::half*>(q.data_ptr());
        const int64_t qs0 = q.stride(0), qs1 = q.stride(1);
        const int HqL = Hq; const float* sg = rsign;
        queue_of(q).submit([&](sycl::handler& h) {
            sycl::local_accessor<float, 1> xs(256, h);
            h.parallel_for(sycl::nd_range<1>(rows * 256, 256), [=](sycl::nd_item<1> it) {
                const int d = it.get_local_id(0); const int64_t r = it.get_group(0);
                const int64_t t = r / HqL; const int hh = (int)(r % HqL);
                auto grp = it.get_group();
                xs[d] = (float)qi[t * qs0 + hh * qs1 + d] * sg[d];
                sycl::group_barrier(grp);
                for (int L = 1; L < 256; L <<= 1) {
                    if ((d & L) == 0) { float lo = xs[d], hi = xs[d + L]; xs[d] = lo + hi; xs[d + L] = lo - hi; }
                    sycl::group_barrier(grp);
                }
                qo[r * 256 + d] = xs[d] * (1.0f / 256.0f);
            });
        });
        qrot = qo;
    }
    sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
    auto launch = [&](auto kern) { qq.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(n, G), props, kern); }); };
    auto fill = [&](auto& kern) {
        kern.q = reinterpret_cast<const sycl::half*>(q.data_ptr());
        kern.kc = reinterpret_cast<const sycl::half*>(k_cache.data_ptr());
        kern.vc = reinterpret_cast<const sycl::half*>(v_cache.data_ptr());
        kern.block_table = bt.data_ptr<int>(); kern.seqused = seqused.data_ptr<int>();
        kern.opart = reinterpret_cast<sycl::half*>(opart.data_ptr()); kern.lpart = lpart.data_ptr<float>();
        kern.B = B; kern.QL = (int)q_len; kern.Hq = Hq; kern.Hk = Hk; kern.G = G; kern.BS = BS; kern.S = S;
        kern.bt_stride = (int)bt.stride(0); kern.scale_log2 = (float)(scale * 1.4426950408889634);
        kern.kbs = (size_t)k_cache.stride(0); kern.vbs = (size_t)v_cache.stride(0);
        kern.tstride = (int)k_cache.stride(1); kern.hstride = (int)k_cache.stride(2);
        kern.qsl = qsl ? qsl->data_ptr<int>() : nullptr;
        kern.hp = hp ? 1 : 0;
        // VARR loses at long context (97k B=3 +80%, B=4 +46%;
        // 49k B=4 +6%) and wins up to ~49k at B 2-3 (-4..-5.5%): gate it per sequence inside the kernel
        static const int varr_maxl = [] { const char* e = std::getenv("EXL3_SPEC_VARR_MAXL"); return e ? std::atoi(e) : 40000; }();
        kern.varr_maxl = varr_maxl;
    };
    if (f8) {
        exl3fa::FaSpecKernelT<1> kern{}; fill(kern);
        kern.ks = ksc.data_ptr<float>(); kern.vs = vsc.data_ptr<float>();
        launch(kern);
    } else if (i4) {
        // the <KVM, true> instance compiles without spilling the O accumulator (IGC RA
        // heuristic: the plain instance spills 5.2-5.8 KB incl. all of O); EXL3_SPEC_VAT=0: the plain instance
        static const int vat = [] { const char* e = std::getenv("EXL3_SPEC_VAT"); return e ? std::atoi(e) : 0; }();
        if (vat) { exl3fa::FaSpecKernelT<3, true> kern{}; fill(kern); kern.rsign = rsign; kern.qrot = qrot; launch(kern); }
        else { exl3fa::FaSpecKernelT<3> kern{}; fill(kern); kern.rsign = rsign; kern.qrot = qrot; launch(kern); }
    } else if (i8) {
        // VARR: 4-tile V loads for B >= 2 (EXL3_SPEC_VARR=0 disables; default on)
        static const int varr_env = [] { const char* e = std::getenv("EXL3_SPEC_VARR"); return e ? std::atoi(e) : 1; }();
        static const int vat8 = [] { const char* e = std::getenv("EXL3_SPEC_VAT"); return e ? std::atoi(e) : 0; }();
        if (varr_env && !hp && B >= 2) { exl3fa::FaSpecKernelT<2, true> kern{}; fill(kern); launch(kern); }
        else if (vat8 && !hp) { exl3fa::FaSpecKernelT<2, true> kern{}; fill(kern); kern.va_min_b = 1 << 30; launch(kern); }
        else { exl3fa::FaSpecKernelT<2> kern{}; fill(kern); launch(kern); }
    } else {
        exl3fa::FaSpecKernelT<0> kern{}; fill(kern);
        launch(kern);
    }
    int out_stride = out.dim() == 3 ? (int)out.stride(0) : (int)out.stride(0);
    TORCH_CHECK(Sp <= exl3fa::MERGE_MAX_S, "exl3_spec_attn: at most MERGE_MAX_S splits");
    int nm = B * (int)q_len * Hq * 256;
    qq.submit([&](sycl::handler& h) {
        exl3fa::FaSpecMerge mk{reinterpret_cast<const sycl::half*>(opart.data_ptr()), lpart.data_ptr<float>(),
                               reinterpret_cast<sycl::half*>(out.data_ptr()), B, (int)q_len, Hq, Sp, 256, out_stride,
                               qsl ? qsl->data_ptr<int>() : nullptr,
                               sycl::local_accessor<float, 1>(exl3fa::MERGE_MAX_S, h),
                               sycl::local_accessor<float, 1>(256, h), rsign};
        h.parallel_for(sycl::nd_range<1>(nm, 256), mk);
    });
}

void exl3_spec_attn(at::Tensor q, at::Tensor k_cache, at::Tensor v_cache, at::Tensor block_table, at::Tensor seqused,
                    at::Tensor out, int64_t q_len, double scale, int64_t splits,
                    std::optional<at::Tensor> k_scale, std::optional<at::Tensor> v_scale, std::optional<at::Tensor> rot) {
    spec_attn_impl(q, k_cache, v_cache, block_table, seqused, out, q_len, scale, splits, k_scale, v_scale, nullptr, rot);
}

// varlen decode/spec batch (requests with 1..8 query rows each, e.g. the MTP drafter's first
// pass after different acceptance counts) in one launch with no host sync; requests with > 8 rows are skipped.
void exl3_spec_attn_varlen(at::Tensor q, at::Tensor k_cache, at::Tensor v_cache, at::Tensor block_table, at::Tensor seqused,
                           at::Tensor query_start_loc, at::Tensor out, double scale, int64_t splits,
                           std::optional<at::Tensor> k_scale, std::optional<at::Tensor> v_scale, std::optional<at::Tensor> rot) {
    spec_attn_impl(q, k_cache, v_cache, block_table, seqused, out, 8, scale, splits, k_scale, v_scale, &query_start_loc, rot);
}

// ---- chunk prefill attention straight from the int8_per_token_head cache (fa_prefill_i8.h).
// q [Lq, Hq, 256] fp16 contiguous (the last Lq of seq_len tokens; their K/V are already in the cache), pages = block
// ids of the sequence, out rows may be strided. variant: 0 = int8 PV (default), 1 = fp16 PV; nq = query tiles per WG.
void exl3_i8_prefill_attn(at::Tensor q, at::Tensor kview, at::Tensor pages, int64_t seq_len, double scale, at::Tensor out,
                          int64_t variant, int64_t nq) {
    TORCH_CHECK(q.scalar_type() == at::kHalf && q.dim() == 3 && q.size(2) == 256 && q.is_contiguous(), "q [Lq, Hq, 256] fp16");
    TORCH_CHECK(kview.scalar_type() == at::kChar && kview.dim() == 4 && kview.size(3) == 260 && kview.stride(3) == 1 &&
                kview.stride(2) == 520 && kview.stride(1) == kview.size(2) * 520 && kview.stride(1) % 16 == 0 &&
                kview.stride(0) % 64 == 0 && (reinterpret_cast<uintptr_t>(kview.data_ptr()) % 64) == 0,
                "exl3_i8_prefill_attn: vLLM int8_per_token_head K view [blocks, BS, H, 260]");
    TORCH_CHECK(kview.size(1) % 64 == 0, "block_size must be a multiple of 64");
    TORCH_CHECK(pages.scalar_type() == at::kInt && pages.is_contiguous());
    TORCH_CHECK(out.scalar_type() == at::kHalf && out.size(-1) == 256 && out.stride(-1) == 1);
    int Lq = q.size(0), Hq = q.size(1), Hk = kview.size(2);
    TORCH_CHECK(Hq % Hk == 0 && seq_len >= Lq && pages.size(0) * kview.size(1) >= seq_len);
    if (Lq == 0) return;
    int G = Hq / Hk;
    int out_stride = (int)out.stride(0);
    TORCH_CHECK(out.dim() == 3 ? out.stride(1) == 256 : out.dim() == 2, "out [Lq, Hq, 256] or [Lq, Hq*256] rows");
    auto& qq = queue_of(q);
    sycl::ext::oneapi::experimental::properties props{sycl::ext::intel::experimental::grf_size<256>};
    auto run = [&](auto kern) {
        constexpr int NQ = decltype(kern)::NQ_;
        kern.q = reinterpret_cast<const sycl::half*>(q.data_ptr());
        kern.kc = reinterpret_cast<const uint8_t*>(kview.data_ptr());
        kern.pages = pages.data_ptr<int>();
        kern.out = reinterpret_cast<sycl::half*>(out.data_ptr());
        kern.Lq = Lq; kern.L = (int)seq_len; kern.Hq = Hq; kern.Hk = Hk; kern.G = G; kern.BS = (int)kview.size(1);
        kern.out_stride = out_stride; kern.nqt = (Lq + 7) / 8;
        kern.scale_log2 = (float)(scale * 1.4426950408889634);
        kern.kbs = (size_t)kview.stride(0); kern.tstride = (int)kview.stride(1); kern.hstride = (int)kview.stride(2);
        int nqg = (kern.nqt + NQ - 1) / NQ;
        int wg = NQ * G;
        qq.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)nqg * Hk * wg, wg), props, kern); });
    };
    // variant: 0 = int8 PV, 64-key blocks, lazy rescale (default); 1 = fp16 PV, 32-key; 2 = int8 PV, 32-key, lazy;
    //          3 = int8 PV, 64-key, eager rescale
    switch (variant * 4 + (int)nq) {
        case 0 * 4 + 1: run(exl3fp::FaPrefillI8<1, true, 4, true>{}); break;
        case 0 * 4 + 2: run(exl3fp::FaPrefillI8<2, true, 4, true>{}); break;
        case 1 * 4 + 1: run(exl3fp::FaPrefillI8<1, false, 2, true>{}); break;
        case 1 * 4 + 2: run(exl3fp::FaPrefillI8<2, false, 2, true>{}); break;
        case 2 * 4 + 1: run(exl3fp::FaPrefillI8<1, true, 2, true>{}); break;
        case 2 * 4 + 2: run(exl3fp::FaPrefillI8<2, true, 2, true>{}); break;
        case 3 * 4 + 1: run(exl3fp::FaPrefillI8<1, true, 4, false>{}); break;
        case 3 * 4 + 2: run(exl3fp::FaPrefillI8<2, true, 4, false>{}); break;
        default: TORCH_CHECK(false, "exl3_i8_prefill_attn: variant 0..3, nq 1..2");
    }
}

// ---- head-major variant for the oneDNN SDPA prefill path: tokens [0, n) of one sequence ->
// k_out/v_out [H, Lp, 256] fp16 (Lp >= n; rows [n, Lp) are zeroed so padded keys are finite; the causal mask hides them).
void exl3_i8_gather_dequant_hm(at::Tensor kview, at::Tensor pages, int64_t n, at::Tensor k_out, at::Tensor v_out) {
    TORCH_CHECK(kview.scalar_type() == at::kChar && kview.dim() == 4 && kview.size(3) == 260 && kview.stride(3) == 1 &&
                kview.stride(2) == 520, "exl3_i8_gather_dequant_hm: vLLM int8_per_token_head K view [blocks, BS, H, 260]");
    TORCH_CHECK(pages.scalar_type() == at::kInt && k_out.scalar_type() == at::kHalf && v_out.scalar_type() == at::kHalf);
    const int64_t H = kview.size(2), BS = kview.size(1);
    TORCH_CHECK(k_out.is_contiguous() && v_out.is_contiguous() && k_out.dim() == 3 && k_out.size(0) == H && k_out.size(2) == 256 &&
                v_out.sizes() == k_out.sizes() && k_out.size(1) >= n);
    const int64_t Lp = k_out.size(1);
    if (Lp <= 0) return;
    const int8_t* base = reinterpret_cast<const int8_t*>(kview.data_ptr());
    const int* pg = pages.data_ptr<int>();
    const int64_t bstride = kview.stride(0), tstride = kview.stride(1);
    sycl::half* ko = reinterpret_cast<sycl::half*>(k_out.data_ptr());
    sycl::half* vo = reinterpret_cast<sycl::half*>(v_out.data_ptr());
    auto& q = queue_of(kview);
    const int64_t items = Lp * H * 2 * 16;
    q.parallel_for(sycl::range<1>(items), [=](sycl::id<1> id) {
        int64_t i = id[0];
        int lane = (int)(i % 16); i /= 16;
        int kv = (int)(i % 2); i /= 2;
        int h = (int)(i % H); int64_t t = i / H;
        sycl::half* dst = (kv ? vo : ko) + ((int64_t)h * Lp + t) * 256 + lane * 16;
        sycl::vec<sycl::half, 16> y;
        if (t < n) {
            int64_t blk = pg[t / BS], slot = t % BS;
            const int8_t* row = base + blk * bstride + slot * tstride + (int64_t)h * 520 + kv * 260;
            float sc = *reinterpret_cast<const float*>(row + 256);
            sycl::vec<int8_t, 16> x;
            x.load(0, sycl::multi_ptr<const int8_t, sycl::access::address_space::global_space>(row + lane * 16));
            for (int j = 0; j < 16; ++j) y[j] = (sycl::half)((float)x[j] * sc);
        } else {
            for (int j = 0; j < 16; ++j) y[j] = (sycl::half)0.0f;
        }
        y.store(0, sycl::multi_ptr<sycl::half, sycl::access::address_space::global_space>(dst));
    });
}

// ---- fused gather + dequant of vLLM's int8_per_token_head cache (NHD, rows of
// [K int8 x256 | ks f32 | V int8 x256 | vs f32]) for tokens [start, end) of one sequence -> fp16 K, V [n, H, 256].
// One work-item per (token, head, K|V); 16-byte loads, fp16 stores. Replaces a 5-kernel torch chain in prefill.
void exl3_i8_gather_dequant(at::Tensor kview, at::Tensor pages, int64_t start, int64_t end, at::Tensor k_out, at::Tensor v_out) {
    TORCH_CHECK(kview.scalar_type() == at::kChar && kview.dim() == 4 && kview.size(3) == 260 && kview.stride(3) == 1 &&
                kview.stride(2) == 520, "exl3_i8_gather_dequant: vLLM int8_per_token_head K view [blocks, BS, H, 260]");
    TORCH_CHECK(pages.scalar_type() == at::kInt && k_out.scalar_type() == at::kHalf && v_out.scalar_type() == at::kHalf);
    const int64_t n = end - start, H = kview.size(2), BS = kview.size(1);
    TORCH_CHECK(k_out.is_contiguous() && v_out.is_contiguous() && k_out.numel() >= n * H * 256 && v_out.numel() >= n * H * 256);
    if (n <= 0) return;
    const int8_t* base = reinterpret_cast<const int8_t*>(kview.data_ptr());
    const int* pg = pages.data_ptr<int>();
    const int64_t bstride = kview.stride(0), tstride = kview.stride(1);
    sycl::half* ko = reinterpret_cast<sycl::half*>(k_out.data_ptr());
    sycl::half* vo = reinterpret_cast<sycl::half*>(v_out.data_ptr());
    auto& q = queue_of(kview);
    const int64_t items = n * H * 2 * 16;           // 16 work-items per (token, head, K|V) row: 16 bytes each
    q.parallel_for(sycl::range<1>(items), [=](sycl::id<1> id) {
        int64_t i = id[0];
        int lane = (int)(i % 16); i /= 16;
        int kv = (int)(i % 2); i /= 2;
        int h = (int)(i % H); int64_t t = i / H;
        int64_t tok = start + t;
        int64_t blk = pg[tok / BS], slot = tok % BS;
        const int8_t* row = base + blk * bstride + slot * tstride + (int64_t)h * 520 + kv * 260;
        float sc = *reinterpret_cast<const float*>(row + 256);
        sycl::vec<int8_t, 16> x;
        x.load(0, sycl::multi_ptr<const int8_t, sycl::access::address_space::global_space>(row + lane * 16));
        sycl::vec<sycl::half, 16> y;
        for (int j = 0; j < 16; ++j) y[j] = (sycl::half)((float)x[j] * sc);
        sycl::half* dst = (kv ? vo : ko) + (t * H + h) * 256 + lane * 16;
        y.store(0, sycl::multi_ptr<sycl::half, sycl::access::address_space::global_space>(dst));
    });
}

// ---- gather + dequant of vLLM's int4_per_token_head cache. Row per (slot, head): [K 128 B
// packed nibbles (value 2j = low nibble of byte j, 2j+1 = high) | ks f32 | V 128 B | vs f32], 264 B; the 4-bit zero point
// sits in the scale's low 4 mantissa bits (value = (q - zp) * (scale with those bits cleared)). Values stay in vLLM's
// rotated (RHT) space: the caller rotates q and un-rotates the attention output.
static inline void i4_row16(const uint8_t* row, int lane, sycl::vec<sycl::half, 16>& y) {
    uint32_t sb = *reinterpret_cast<const uint32_t*>(row + 128);
    float zp = (float)(sb & 0xF);
    float sc = sycl::bit_cast<float>(sb & 0xFFFFFFF0u);
    sycl::vec<uint8_t, 8> x;
    x.load(0, sycl::multi_ptr<const uint8_t, sycl::access::address_space::global_space>(row + lane * 8));
    for (int j = 0; j < 8; ++j) {
        y[2 * j] = (sycl::half)(((float)(x[j] & 0xF) - zp) * sc);
        y[2 * j + 1] = (sycl::half)(((float)(x[j] >> 4) - zp) * sc);
    }
}

void exl3_i4_gather_dequant_hm(at::Tensor kview, at::Tensor pages, int64_t n, at::Tensor k_out, at::Tensor v_out) {
    TORCH_CHECK((kview.scalar_type() == at::kByte || kview.scalar_type() == at::kChar) && kview.dim() == 4 &&
                kview.size(3) == 132 && kview.stride(3) == 1 && kview.stride(2) == 264,
                "exl3_i4_gather_dequant_hm: vLLM int4_per_token_head K view [blocks, BS, H, 132]");
    TORCH_CHECK(pages.scalar_type() == at::kInt && k_out.scalar_type() == at::kHalf && v_out.scalar_type() == at::kHalf);
    const int64_t H = kview.size(2), BS = kview.size(1);
    TORCH_CHECK(k_out.is_contiguous() && v_out.is_contiguous() && k_out.dim() == 3 && k_out.size(0) == H && k_out.size(2) == 256 &&
                v_out.sizes() == k_out.sizes() && k_out.size(1) >= n);
    const int64_t Lp = k_out.size(1);
    if (Lp <= 0) return;
    const uint8_t* base = reinterpret_cast<const uint8_t*>(kview.data_ptr());
    const int* pg = pages.data_ptr<int>();
    const int64_t bstride = kview.stride(0), tstride = kview.stride(1);
    sycl::half* ko = reinterpret_cast<sycl::half*>(k_out.data_ptr());
    sycl::half* vo = reinterpret_cast<sycl::half*>(v_out.data_ptr());
    auto& q = queue_of(kview);
    const int64_t items = Lp * H * 2 * 16;
    q.parallel_for(sycl::range<1>(items), [=](sycl::id<1> id) {
        int64_t i = id[0];
        int lane = (int)(i % 16); i /= 16;
        int kv = (int)(i % 2); i /= 2;
        int h = (int)(i % H); int64_t t = i / H;
        sycl::half* dst = (kv ? vo : ko) + ((int64_t)h * Lp + t) * 256 + lane * 16;
        sycl::vec<sycl::half, 16> y;
        if (t < n) {
            int64_t blk = pg[t / BS], slot = t % BS;
            i4_row16(base + blk * bstride + slot * tstride + (int64_t)h * 264 + kv * 132, lane, y);
        } else {
            for (int j = 0; j < 16; ++j) y[j] = (sycl::half)0.0f;
        }
        y.store(0, sycl::multi_ptr<sycl::half, sycl::access::address_space::global_space>(dst));
    });
}

void exl3_i4_gather_dequant(at::Tensor kview, at::Tensor pages, int64_t start, int64_t end, at::Tensor k_out, at::Tensor v_out) {
    TORCH_CHECK((kview.scalar_type() == at::kByte || kview.scalar_type() == at::kChar) && kview.dim() == 4 &&
                kview.size(3) == 132 && kview.stride(3) == 1 && kview.stride(2) == 264,
                "exl3_i4_gather_dequant: vLLM int4_per_token_head K view [blocks, BS, H, 132]");
    TORCH_CHECK(pages.scalar_type() == at::kInt && k_out.scalar_type() == at::kHalf && v_out.scalar_type() == at::kHalf);
    const int64_t n = end - start, H = kview.size(2), BS = kview.size(1);
    TORCH_CHECK(k_out.is_contiguous() && v_out.is_contiguous() && k_out.numel() >= n * H * 256 && v_out.numel() >= n * H * 256);
    if (n <= 0) return;
    const uint8_t* base = reinterpret_cast<const uint8_t*>(kview.data_ptr());
    const int* pg = pages.data_ptr<int>();
    const int64_t bstride = kview.stride(0), tstride = kview.stride(1);
    sycl::half* ko = reinterpret_cast<sycl::half*>(k_out.data_ptr());
    sycl::half* vo = reinterpret_cast<sycl::half*>(v_out.data_ptr());
    auto& q = queue_of(kview);
    const int64_t items = n * H * 2 * 16;
    q.parallel_for(sycl::range<1>(items), [=](sycl::id<1> id) {
        int64_t i = id[0];
        int lane = (int)(i % 16); i /= 16;
        int kv = (int)(i % 2); i /= 2;
        int h = (int)(i % H); int64_t t = i / H;
        int64_t tok = start + t;
        int64_t blk = pg[tok / BS], slot = tok % BS;
        sycl::vec<sycl::half, 16> y;
        i4_row16(base + blk * bstride + slot * tstride + (int64_t)h * 264 + kv * 132, lane, y);
        y.store(0, sycl::multi_ptr<sycl::half, sycl::access::address_space::global_space>((kv ? vo : ko) + (t * H + h) * 256 + lane * 16));
    });
}

// ---- fused int4_per_token_head KV write. vLLM on XPU runs single_rht as a PyTorch
// butterfly (its Hadamard fast paths need CUDA): K and V each pay a float cast, a sign multiply, 8 x (view, stack,
// reshape) stages and a cast back before the pack kernel, ~40 small kernels per attention layer per step. This does
// the whole write in one launch with the same arithmetic: optional K smoothing (k - m), x * signs, the same fp32
// butterfly order, the fp16 round (.to(key.dtype)), then vLLM's _reshape_cache_int4_kernel math (asymmetric scale,
// round-half-away zero point and values, zp in the scale's low 4 mantissa bits, nibble pack: element 2j = low nibble).
// One 256-item work-group per (token, head, K|V) row; slot < 0 = skip.
void exl3_i4_kv_write(at::Tensor key, at::Tensor value, at::Tensor kview, at::Tensor slot_mapping, at::Tensor signs,
                      std::optional<at::Tensor> kmean) {
    TORCH_CHECK(kview.scalar_type() == at::kByte && kview.dim() == 4 && kview.size(3) == 132 && kview.stride(3) == 1 &&
                kview.stride(2) == 264, "exl3_i4_kv_write: vLLM int4_per_token_head K view [blocks, BS, H, 132]");
    TORCH_CHECK(key.scalar_type() == at::kHalf && value.scalar_type() == at::kHalf && key.dim() == 3 && value.dim() == 3 &&
                key.size(2) == 256 && value.size(2) == 256 && key.stride(2) == 1 && value.stride(2) == 1,
                "exl3_i4_kv_write: key/value fp16 [T, H, 256], last dim contiguous");
    TORCH_CHECK(signs.scalar_type() == at::kFloat && signs.numel() == 256 && signs.is_contiguous());
    TORCH_CHECK(slot_mapping.scalar_type() == at::kLong);
    const int64_t T = std::min<int64_t>(key.size(0), slot_mapping.size(0)), H = key.size(1), BS = kview.size(1);
    TORCH_CHECK(kview.size(2) == H && value.size(0) >= T && value.size(1) == H);
    if (T <= 0) return;
    const sycl::half* kp = reinterpret_cast<const sycl::half*>(key.data_ptr());
    const sycl::half* vp = reinterpret_cast<const sycl::half*>(value.data_ptr());
    const int64_t kst = key.stride(0), ksh = key.stride(1), vst = value.stride(0), vsh = value.stride(1);
    const float* sg = signs.data_ptr<float>();
    const float* km = nullptr;
    if (kmean.has_value() && kmean->defined()) {
        TORCH_CHECK(kmean->scalar_type() == at::kHalf || kmean->scalar_type() == at::kFloat);
        TORCH_CHECK(kmean->numel() == H * 256 && kmean->is_contiguous() && kmean->scalar_type() == at::kFloat,
                    "exl3_i4_kv_write: kmean float32 [H, 256]");
        km = kmean->data_ptr<float>();
    }
    const int64_t* sm = slot_mapping.data_ptr<int64_t>();
    uint8_t* base = reinterpret_cast<uint8_t*>(kview.data_ptr());
    const int64_t bstride = kview.stride(0), tstride = kview.stride(1);
    auto& q = queue_of(kview);
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<float, 1> xs(256, h);
        sycl::local_accessor<int, 1> qs(256, h);
        h.parallel_for(sycl::nd_range<1>(T * H * 2 * 256, 256), [=](sycl::nd_item<1> it) {
            const int d = it.get_local_id(0);
            int64_t r = it.get_group(0);
            const int kv = (int)(r % 2); r /= 2;
            const int hh = (int)(r % H); const int64_t t = r / H;
            const int64_t slot = sm[t];
            if (slot < 0) return;                      // uniform per work-group
            auto grp = it.get_group();
            float x = kv ? (float)vp[t * vst + hh * vsh + d] : (float)kp[t * kst + hh * ksh + d];
            if (!kv && km) x = (float)(sycl::half)(x - (float)(sycl::half)km[hh * 256 + d]);   // = fp16 (key - m)
            xs[d] = x * sg[d];
            sycl::group_barrier(grp);
            for (int L = 1; L < 256; L <<= 1) {
                if ((d & L) == 0) { float lo = xs[d], hi = xs[d + L]; xs[d] = lo + hi; xs[d + L] = lo - hi; }
                sycl::group_barrier(grp);
            }
            x = (float)(sycl::half)xs[d];              // single_rht(...).to(fp16)
            const float mn = sycl::reduce_over_group(grp, x, sycl::minimum<float>());
            const float mx = sycl::reduce_over_group(grp, x, sycl::maximum<float>());
            const float sc = sycl::fmax((mx - mn) / 15.0f, 1e-6f);
            const float zt = -mn / sc;
            const float zp = sycl::clamp((float)(zt >= 0.0f ? (int)(zt + 0.5f) : (int)(zt - 0.5f)), 0.0f, 15.0f);
            const float inv = 1.0f / sc;
            const float v = x * inv + zp;
            const int qv = (int)sycl::clamp((float)(v >= 0.0f ? (int)(v + 0.5f) : (int)(v - 0.5f)), 0.0f, 15.0f);
            qs[d] = qv;
            sycl::group_barrier(grp);
            uint8_t* row = base + (slot / BS) * bstride + (slot % BS) * tstride + (int64_t)hh * 264 + kv * 132;
            if (d < 128) row[d] = (uint8_t)((qs[2 * d] & 0xF) | ((qs[2 * d + 1] & 0xF) << 4));
            if (d == 0) {
                uint32_t bits = sycl::bit_cast<uint32_t>(sc);
                bits = (bits & 0xFFFFFFF0u) | ((uint32_t)zp & 0xFu);
                *reinterpret_cast<uint32_t*>(row + 128) = bits;
            }
        });
    });
}

// ---- debug: one int8 DPAS with the layouts FaSpecKernelT<2> uses.
// A [8, 32] int8 row-major; Bw [8, 16] int32 = VNNI dwords (4 consecutive k of one column n); C [8, 16] int32.
struct DpasI8Probe {
    const int8_t* a; const uint32_t* bw; int* c;
    void operator()(sycl::nd_item<1>) const SYCL_ESIMD_KERNEL {
        using namespace sycl::ext::intel::esimd;
        namespace xmx = sycl::ext::intel::esimd::xmx;
        simd<int8_t, 256> av = block_load<int8_t, 256>(a);
        simd<uint32_t, 128> bv = block_load<uint32_t, 128>(bw);
        simd<int, 128> acc = 0;
        acc = xmx::dpas<8, 8, int, int, int8_t, int8_t>(acc, bv.template bit_cast_view<int8_t>().read(), av);
        block_store<int, 128>(c, acc);
    }
};
void exl3_dpas_i8_probe(at::Tensor a, at::Tensor bw, at::Tensor c) {
    auto& q = queue_of(a);
    DpasI8Probe k{reinterpret_cast<const int8_t*>(a.data_ptr()), reinterpret_cast<const uint32_t*>(bw.data_ptr()), c.data_ptr<int>()};
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(1, 1), k); });
}

// ---- debug: one s8 x u4 DPAS (A [8, 32] int8 row-major, B = 64 dwords of nibbles as given, C [8, 16])
struct DpasU4Probe {
    const int8_t* a; const uint32_t* bw; int* c;
    void operator()(sycl::nd_item<1>) const SYCL_ESIMD_KERNEL {
        using namespace sycl::ext::intel::esimd;
        namespace xmx = sycl::ext::intel::esimd::xmx;
        simd<int8_t, 256> av = block_load<int8_t, 256>(a);
        simd<uint32_t, 64> bv = block_load<uint32_t, 64>(bw);
        simd<int, 128> acc = 0;
        acc = xmx::dpas<8, 8, int, int, uint32_t, int8_t, xmx::dpas_argument_type::u4, xmx::dpas_argument_type::s8>(acc, bv, av);
        block_store<int, 128>(c, acc);
    }
};
void exl3_dpas_u4_probe(at::Tensor a, at::Tensor bw, at::Tensor c) {
    auto& q = queue_of(a);
    DpasU4Probe k{reinterpret_cast<const int8_t*>(a.data_ptr()), reinterpret_cast<const uint32_t*>(bw.data_ptr()), c.data_ptr<int>()};
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(1, 1), k); });
}

// ---- fused top-k/top-p logits mask (in place), one work-group per row; see topkp_sycl.h
void exl3_topk_topp_mask(at::Tensor logits, at::Tensor k, std::optional<at::Tensor> p, at::Tensor flags) {
    TORCH_CHECK(logits.dim() == 2 && logits.scalar_type() == at::kFloat && logits.stride(1) == 1);
    TORCH_CHECK(k.scalar_type() == at::kInt || k.scalar_type() == at::kLong);
    int R = logits.size(0), V = logits.size(1);
    TORCH_CHECK(k.numel() >= R && k.is_contiguous());
    TORCH_CHECK(V % 4 == 0 && logits.stride(0) % 4 == 0 && (reinterpret_cast<uintptr_t>(logits.data_ptr()) % 16) == 0,
                "exl3_topk_topp_mask: rows must be float4-aligned");
    const float* pp = nullptr;
    at::Tensor pc;
    if (p.has_value() && p->defined()) {
        pc = p->scalar_type() == at::kFloat ? p->contiguous() : p->to(at::kFloat).contiguous();
        TORCH_CHECK(pc.numel() >= R);
        pp = pc.data_ptr<float>();
    }
    int* fl = flags.defined() && flags.numel() >= R ? flags.data_ptr<int>() : nullptr;
    if (R == 0) return;
    auto& q = queue_of(logits);
    float* lp = logits.data_ptr<float>();
    int64_t rs = logits.stride(0);
    const void* kp = k.data_ptr();
    int k64 = k.scalar_type() == at::kLong;
    q.submit([&](sycl::handler& h) {
        exl3tk::TopKPMask kern{lp, rs, V, kp, k64, pp, fl,
                               sycl::local_accessor<uint32_t, 1>(exl3tk::NB, h),
                               sycl::local_accessor<float, 1>(exl3tk::TOPKP_CAP, h),
                               sycl::local_accessor<uint32_t, 1>(8, h)};
        h.parallel_for(sycl::nd_range<1>((size_t)R * exl3tk::WG, exl3tk::WG), kern);
    });
}

// ---- diagnostic: stream the trellis with exactly the MB=8 DPAS thread mapping (strip of NT tiles x K split),
// no decode, no DPAS: an xor-reduce per thread. Tells whether the access pattern + static split partition can
// reach the DRAM ceiling on their own.
struct StreamProbe {
    const uint32_t* tr; uint32_t* out; int tiles_n, rps, n_strips, tk, W, NT;
    void operator()(sycl::nd_item<1> it) const SYCL_ESIMD_KERNEL {
        int id = it.get_global_id(0);
        int strip = id % n_strips, p = id / n_strips;
        int r0 = p * rps, r1 = r0 + rps; if (r1 > tk) r1 = tk;
        simd<uint32_t, 128> acc = 0;
        for (int r = r0; r < r1; ++r) acc ^= block_load<uint32_t, 128>(tr + ((size_t)r * tiles_n + strip * 4) * 32);
        simd<uint32_t, 16> o = acc.template select<16, 1>(0);
#pragma unroll
        for (int i = 1; i < 8; ++i) o ^= acc.template select<16, 1>(16 * i);
        block_store<uint32_t, 16>(out + (size_t)id * 16, o);
    }
};
void exl3_stream_probe(at::Tensor trellis, at::Tensor out, int64_t M) {
    TORCH_CHECK(trellis.size(2) == 64, "K=4 trellis only");   // 8K = 32 words = 64 shorts per tile
    int tk = trellis.size(0), tiles_n = trellis.size(1);
    int n_strips = tiles_n / 4;
    int P = std::max(1, std::min(tk, (g_target_threads_mb16 + n_strips - 1) / n_strips));
    int rps = (tk + P - 1) / P; P = (tk + rps - 1) / rps;
    TORCH_CHECK(out.numel() >= (int64_t)n_strips * P * 16);
    auto& q = queue_of(trellis);
    StreamProbe k{reinterpret_cast<const uint32_t*>(trellis.data_ptr()), reinterpret_cast<uint32_t*>(out.data_ptr()),
                  tiles_n, rps, n_strips, tk, 32, 4};
    int n = n_strips * P;
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, 8), 8), k); });
}

// ---- fused residual add + RMSNorm (decode, small M), see norm_sycl.h
void exl3_fused_add_rms_norm(at::Tensor x, at::Tensor residual, at::Tensor weight, double eps) {
    TORCH_CHECK(x.dim() == 2 && x.scalar_type() == at::kHalf && x.stride(1) == 1);
    TORCH_CHECK(residual.sizes() == x.sizes() && residual.scalar_type() == at::kHalf && residual.stride(1) == 1);
    TORCH_CHECK(weight.scalar_type() == at::kHalf && weight.is_contiguous() && weight.numel() == x.size(1));
    int M = x.size(0), H = x.size(1);
    TORCH_CHECK(H % exl3norm::VEC == 0);
    if (M == 0) return;
    auto& q = queue_of(x);
    exl3norm::FusedAddRms k{reinterpret_cast<sycl::half*>(x.data_ptr<at::Half>()), reinterpret_cast<sycl::half*>(residual.data_ptr<at::Half>()),
                            reinterpret_cast<const sycl::half*>(weight.data_ptr<at::Half>()), H, (int)x.stride(0), (int)residual.stride(0), (float)eps};
    int L = exl3_norm_wg();
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)M * L, L), k); });
}

// ---- fused MLP for decode batches (3 <= M <= 8, DPAS MB=8): had_in -> gate_up DPAS -> MlpMid -> down DPAS -> had_out
template <int K>
static at::Tensor dpas8_parts(const at::Tensor& xh, const at::Tensor& tr, const at::Tensor& shard, int M, int Kdim, int N,
                              sycl::queue& q) {
    int tk = Kdim / 16, n_strips = (N / 16) / EXL3_DPAS8_NT;
    int P = std::max(1, std::min(tk, (g_target_threads_mb16 + n_strips - 1) / n_strips));
    int rps = (tk + P - 1) / P;
    P = (tk + rps - 1) / rps;
    auto part = at::empty({P, M, N}, xh.options().dtype(at::kFloat));
    launch_dpas<K, 2, 8, EXL3_DPAS8_NT>(xh, tr, shard, part, M, Kdim, N, P, rps, q);
    return part;
}
void exl3_mlp_small(at::Tensor x, at::Tensor gu_tr, at::Tensor gu_suh, at::Tensor gu_svh, at::Tensor gu_shard,
                    at::Tensor dn_tr, at::Tensor dn_suh, at::Tensor dn_svh, at::Tensor dn_shard, at::Tensor out,
                    int64_t K_gu, int64_t K_dn) {
    TORCH_CHECK(x.dim() == 2 && x.scalar_type() == at::kHalf && x.stride(1) == 1 && out.scalar_type() == at::kHalf);
    TORCH_CHECK(gu_suh.size(0) == 1 || gu_suh.size(0) == 2, "gate_up: 1 or 2 input shards");
    TORCH_CHECK(dn_suh.size(0) == 1, "down: one shard");
    int M = x.size(0), H = x.size(1), N2 = gu_svh.size(0), I = N2 / 2, Hn = dn_svh.size(0);
    TORCH_CHECK(M >= 1 && M <= 8 && dn_suh.size(1) == I && out.size(0) == M && out.size(1) == Hn);
    auto& q = queue_of(x);
    const int Mp = 8, S = gu_suh.size(0);
    auto xh = at::empty({S, Mp, H}, x.options());
    launch_had_in<fp16>(x, gu_suh, xh, q);
    at::Tensor part = K_gu == 4 ? dpas8_parts<4>(xh, gu_tr, gu_shard, M, H, N2, q) : dpas8_parts<6>(xh, gu_tr, gu_shard, M, H, N2, q);
    auto xh2 = at::empty({1, Mp, I}, x.options());
    MlpMidKernel mk{part.data_ptr<float>(), (int)part.size(0), M, I, reinterpret_cast<const fp16*>(gu_svh.data_ptr()),
                    reinterpret_cast<const fp16*>(dn_suh.data_ptr()), reinterpret_cast<fp16*>(xh2.data_ptr()), Mp};
    int n = Mp * (I / 128);
    q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n, 8), 8), mk); });
    at::Tensor part2 = K_dn == 4 ? dpas8_parts<4>(xh2, dn_tr, dn_shard, M, I, Hn, q) : dpas8_parts<6>(xh2, dn_tr, dn_shard, M, I, Hn, q);
    launch_had_out<fp16>(part2, (int)part2.size(0), dn_svh, out, q);
}
at::Tensor exl3_linear(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
                       std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max, int64_t slice_n);
// Whole MLP (gate_up -> silu*mul -> down) as one op, decided at run time (vLLM traces the model once with a symbolic
// batch size, so a Python-side shape branch would be frozen): fused path for 3..8 fp16 rows, else the two EXL3
// linears with the activation computed in fp32 and stored in the input dtype (as vLLM's act_and_mul).
#ifdef EXL3_DNNL
// prefill MLP with the middle fused (MlpMidQ8WgKernel): had_in_q8(x) -> int8 GEMM gate_up
// -> [had_out + silu*mul + had_in_q8(down)] in one pass -> int8 GEMM down -> had_out. Toggle: exl3_set_mlp_mid_q8.
static bool g_mlp_mid_q8 = true;
void exl3_set_mlp_mid_q8(int64_t on) { g_mlp_mid_q8 = on != 0; }
template <int K> static void launch_reconstruct_q8(const at::Tensor& tr, at::Tensor& w, int n0, sycl::queue& q);
static void q8_gemm_groups(sycl::queue& q, const at::Tensor& like, const at::Tensor& xq, const at::Tensor& sx, int64_t Ms, int64_t k,
                           const at::Tensor& trellis, int64_t K, const std::vector<int64_t>& bounds, at::Tensor& y, int64_t n) {
    static std::vector<at::Tensor> swd(16);
    auto& swt = swd.at(like.device().index());
    if (!swt.defined()) swt = at::full({1}, kQ8WMax / 127.0f, like.options().dtype(at::kFloat));
    for (size_t g = 0; g + 1 < bounds.size(); ++g) {
        int64_t g0 = bounds[g], g1 = bounds[g + 1], ng = g1 - g0;
        auto w = at::empty({k, ng}, like.options().dtype(at::kChar));
        if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
        q8dnnl::gemm(q, like, reinterpret_cast<const int8_t*>(xq.data_ptr()) + g * Ms * k,
                     reinterpret_cast<const int8_t*>(w.data_ptr()), swt.data_ptr<float>(),
                     sx.data_ptr<float>() + g * Ms, reinterpret_cast<fp16*>(y.data_ptr()) + g0, Ms, k, ng, n);
    }
}
static at::Tensor exl3_mlp_prefill_q8(const at::Tensor& x2, const at::Tensor& gu_tr, const at::Tensor& gu_suh, const at::Tensor& gu_svh,
                                      const std::vector<int64_t>& gu_bounds, const at::Tensor& dn_tr, const at::Tensor& dn_suh,
                                      const at::Tensor& dn_svh, const std::vector<int64_t>& dn_bounds, int64_t K_gu, int64_t K_dn) {
    auto& q = queue_of(x2);
    auto xc = x2.is_contiguous() ? x2 : x2.contiguous();
    const int64_t M = xc.size(0), k = xc.size(1), n_gu = gu_svh.size(0), I = n_gu / 2, n_dn = dn_svh.size(0);
    const int64_t Ms = (M + 255) / 256 * 256, S = gu_suh.size(0);
    // 1. had_in_q8 of x (as exl3_linear)
    auto xq = at::empty({S, Ms, k}, xc.options().dtype(at::kChar));
    auto sx = at::empty({S, Ms}, xc.options().dtype(at::kFloat));
    {
        int n_in = (int)(S * M), kb_n = (int)(k / 128);
        auto wg = [&](auto kern, int tpr) {
            q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)n_in * tpr, tpr), kern); });
        };
        if (kb_n <= 8 * 6)
            wg(HadInQ8WgKernel<fp16, 8, 6>{reinterpret_cast<const fp16*>(xc.data_ptr()), reinterpret_cast<const fp16*>(gu_suh.data_ptr()),
                                           reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
                                           (int)xc.stride(0), (int)Ms}, 8);
        else
            wg(HadInQ8WgKernel<fp16, 16, 9>{reinterpret_cast<const fp16*>(xc.data_ptr()), reinterpret_cast<const fp16*>(gu_suh.data_ptr()),
                                            reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
                                            (int)xc.stride(0), (int)Ms}, 16);
    }
    // 2. gate_up GEMM (output stays in the rotated basis: no had_out here)
    auto y = at::empty({Ms, n_gu}, xc.options().dtype(at::kHalf));
    q8_gemm_groups(q, xc, xq, sx, Ms, k, gu_tr, K_gu, gu_bounds, y, n_gu);
    // 3. fused middle -> down input int8 + row scales
    auto xq2 = at::empty({1, Ms, I}, xc.options().dtype(at::kChar));
    auto sx2 = at::empty({1, Ms}, xc.options().dtype(at::kFloat));
    {
        MlpMidQ8WgKernel<16, 9> kmid{reinterpret_cast<const fp16*>(y.data_ptr()), (int)n_gu,
                                     reinterpret_cast<const fp16*>(gu_svh.data_ptr()), reinterpret_cast<const fp16*>(dn_suh.data_ptr()),
                                     reinterpret_cast<int8_t*>(xq2.data_ptr()), sx2.data_ptr<float>(), (int)M, (int)I};
        q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)M * 16, 16), kmid); });
    }
    // 4. down GEMM + output Hadamard
    auto y2 = at::empty({Ms, n_dn}, xc.options().dtype(at::kHalf));
    if (g_q8_fold && M >= g_q8_fold_min_m) {
        auto& fs = fold_scales(dn_tr, dn_svh, K_dn, q);
        for (size_t g = 0; g + 1 < dn_bounds.size(); ++g) {
            int64_t g0 = dn_bounds[g], g1 = dn_bounds[g + 1], ng = g1 - g0;
            auto w = at::empty({I, ng}, xc.options().dtype(at::kChar));
            if (K_dn == 4) launch_reconstruct_q8_fold<4>(dn_tr, w, g0, fs.first.data_ptr<float>(), q);
            else launch_reconstruct_q8_fold<6>(dn_tr, w, g0, fs.first.data_ptr<float>(), q);
            q8dnnl::gemm(q, xc, reinterpret_cast<const int8_t*>(xq2.data_ptr()), reinterpret_cast<const int8_t*>(w.data_ptr()),
                         fs.second.data_ptr<float>() + g0, sx2.data_ptr<float>(), reinterpret_cast<fp16*>(y2.data_ptr()) + g0,
                         Ms, I, ng, n_dn, true);
        }
        return y2.narrow(0, 0, M);
    }
    q8_gemm_groups(q, xc, xq2, sx2, Ms, I, dn_tr, K_dn, dn_bounds, y2, n_dn);
    auto out = at::empty({M, n_dn}, xc.options());
    exl3_had_out_h(y2.narrow(0, 0, M), dn_svh, out);
    return out;
}
#endif

at::Tensor exl3_mlp_auto(at::Tensor x, at::Tensor gu_tr, at::Tensor gu_suh, at::Tensor gu_svh, at::Tensor gu_shard,
                         std::vector<int64_t> gu_bounds, at::Tensor dn_tr, at::Tensor dn_suh, at::Tensor dn_svh,
                         at::Tensor dn_shard, std::vector<int64_t> dn_bounds, int64_t K_gu, int64_t K_dn, int64_t cb,
                         int64_t small_m_max, int64_t slice_n) {
    auto shape = x.sizes().vec();
    auto x2 = x.reshape({-1, x.size(-1)});
    int64_t M = x2.size(0);
    shape.back() = dn_svh.size(0);
    if (M >= 3 && M <= 8 && x2.scalar_type() == at::kHalf && cb == 2 && (K_gu == 4 || K_gu == 6) &&
        (K_dn == 4 || K_dn == 6) && gu_suh.size(0) <= 2 && dn_suh.size(0) == 1 && gu_svh.size(0) % 256 == 0) {
        if (!x2.is_contiguous()) x2 = x2.contiguous();
        auto out = at::empty({M, dn_svh.size(0)}, x2.options());
        exl3_mlp_small(x2, gu_tr, gu_suh, gu_svh, gu_shard, dn_tr, dn_suh, dn_svh, dn_shard, out, K_gu, K_dn);
        return out.view(shape);
    }
#ifdef EXL3_DNNL
    if (g_mlp_mid_q8 && g_int8 && cb == 2 && (K_gu == 4 || K_gu == 6) && (K_dn == 4 || K_dn == 6) && M > small_m_max && M > 16 &&
        x2.scalar_type() == at::kHalf && dn_suh.size(0) == 1 && (gu_svh.size(0) / 2) % 128 == 0 &&
        gu_svh.size(0) / 2 / 128 <= 16 * 9 && x2.size(1) / 128 <= 16 * 9) {
        return exl3_mlp_prefill_q8(x2, gu_tr, gu_suh, gu_svh, gu_bounds, dn_tr, dn_suh, dn_svh, dn_bounds, K_gu, K_dn).view(shape);
    }
#endif
    auto gu = exl3_linear(x2, gu_tr, gu_suh, gu_svh, gu_shard, gu_bounds, K_gu, cb, small_m_max, slice_n);
    int64_t I = gu.size(-1) / 2;
    at::Tensor a;
    if (gu.scalar_type() == at::kHalf && gu.is_contiguous() && I % 8 == 0) {
        // silu(g) * u in fp32, stored fp16 (as vLLM's act_and_mul), no fp32 temporaries (prefill-sized M)
        a = at::empty({M, I}, gu.options());
        const sycl::half* src = reinterpret_cast<const sycl::half*>(gu.data_ptr());
        sycl::half* dst = reinterpret_cast<sycl::half*>(a.data_ptr());
        int64_t n8 = M * I / 8, I8 = I / 8;
        queue_of(gu).parallel_for(sycl::range<1>(n8), [=](sycl::id<1> id) {
            int64_t k = id[0], m = k / I8, c = (k % I8) * 8;
            auto g8 = *reinterpret_cast<const sycl::vec<sycl::half, 8>*>(src + m * 2 * I + c);
            auto u8 = *reinterpret_cast<const sycl::vec<sycl::half, 8>*>(src + m * 2 * I + I + c);
            sycl::vec<sycl::half, 8> o;
            for (int j = 0; j < 8; ++j) {
                float g = (float)g8[j];
                o[j] = (sycl::half)(g / (1.0f + sycl::exp(-g)) * (float)u8[j]);
            }
            *reinterpret_cast<sycl::vec<sycl::half, 8>*>(dst + m * I + c) = o;
        });
    } else {
        auto g = gu.narrow(-1, 0, I).to(at::kFloat), u = gu.narrow(-1, I, I).to(at::kFloat);
        a = (at::silu(g) * u).to(x2.scalar_type());
    }
    return exl3_linear(a, dn_tr, dn_suh, dn_svh, dn_shard, dn_bounds, K_dn, cb, small_m_max, slice_n).view(shape);
}

at::Tensor exl3_mlp_small_f(at::Tensor x, at::Tensor gu_tr, at::Tensor gu_suh, at::Tensor gu_svh, at::Tensor gu_shard,
                            at::Tensor dn_tr, at::Tensor dn_suh, at::Tensor dn_svh, at::Tensor dn_shard, int64_t K_gu, int64_t K_dn) {
    auto x2 = x.is_contiguous() ? x : x.contiguous();
    auto out = at::empty({x2.size(0), dn_svh.size(0)}, x2.options());
    exl3_mlp_small(x2, gu_tr, gu_suh, gu_svh, gu_shard, dn_tr, dn_suh, dn_svh, dn_shard, out, K_gu, K_dn);
    return out;
}

bool exl3_supported(int64_t K, int64_t cb);

// ------------------------------------------------------------------------------------------------
// The whole EXL3 linear as one C++ op (no Python on the per-call path).
//   M <= small_m_max : fused decode-in-GEMM (vector / DPAS)
//   otherwise        : row-major input Hadamard -> reconstruct W_inner slices -> oneDNN GEMM -> output Hadamard

static at::Tensor& weight_scratch(const at::Device& dev, int64_t numel) {
    static std::vector<at::Tensor> bufs(16);
    auto& b = bufs.at(dev.index());
    if (!b.defined() || b.numel() < numel)
        b = at::empty({numel}, at::TensorOptions().dtype(at::kHalf).device(dev));
    return b;
}

at::Tensor exl3_linear(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
                       std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
                       int64_t slice_n) {
    auto shape = x.sizes().vec();
    int64_t k = shape.back();
    int64_t n = svh.size(0);
    auto x2 = x.reshape({-1, k});
    if (!x2.is_contiguous()) x2 = x2.contiguous();
    int64_t M = x2.size(0);
    shape.back() = n;
    auto out = at::empty({M, n}, x.options());
    if (M == 0) return out.view(shape);
    if (M <= small_m_max && exl3_supported(K, cb)) {
        exl3_gemm_small(x2, trellis, suh, svh, shard_of_nb, out, K, cb);
        return out.view(shape);
    }
    int64_t S = suh.size(0);
    if (g_int8 && cb == 2 && (K == 4 || K == 6) && M > 16) {
        auto& q = queue_of(x2);
#ifdef EXL3_DNNL
        // GEMM rows padded to 256: bounds the number of oneDNN primitives (one per (Ms, K, N)) on real traffic
        const int64_t Ms = (M + 255) / 256 * 256;
#else
        const int64_t Ms = M;
#endif
        auto xq = at::empty({S, Ms, k}, x.options().dtype(at::kChar));
        auto sx = at::empty({S, Ms}, x.options().dtype(at::kFloat));
        int n_in = S * M, local = 8;
        auto run_in = [&](auto tag) {
            using TIn = decltype(tag);
            int kb_n = (int)(k / 128);
            auto wg = [&](auto kern, int tpr) {
                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>((size_t)n_in * tpr, tpr), kern); });
            };
            if (kb_n <= 8 * 6) {
                wg(HadInQ8WgKernel<TIn, 8, 6>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
                                              reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
                                              (int)x2.stride(0), (int)Ms}, 8);
                return;
            }
            if (kb_n <= 16 * 9) {
                wg(HadInQ8WgKernel<TIn, 16, 9>{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
                                               reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
                                               (int)x2.stride(0), (int)Ms}, 16);
                return;
            }
            HadInQ8Kernel<TIn> kin{reinterpret_cast<const TIn*>(x2.data_ptr()), reinterpret_cast<const fp16*>(suh.data_ptr()),
                                   reinterpret_cast<int8_t*>(xq.data_ptr()), sx.data_ptr<float>(), (int)M, (int)k, (int)S,
                                   (int)x2.stride(0), (int)Ms};
            q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_in, local), local), kin); });
        };
        if (x2.scalar_type() == at::kHalf) run_in(fp16{});
        else if (x2.scalar_type() == at::kBFloat16) run_in(sycl::ext::oneapi::bfloat16{});
        else TORCH_CHECK(false, "x dtype");
        const float sw = kQ8WMax / 127.0f;
#ifdef EXL3_DNNL
        {
            static std::vector<at::Tensor> swd(16);
            auto& swt = swd.at(x.device().index());
            if (!swt.defined()) swt = at::full({1}, sw, x.options().dtype(at::kFloat));
            if (g_q8_fold && M >= g_q8_fold_min_m && x2.scalar_type() == at::kHalf) {
                auto& fs = fold_scales(trellis, svh, K, q);
                auto yf = at::empty({Ms, n}, x.options().dtype(at::kHalf));
                for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
                    int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
                    auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
                    if (K == 4) launch_reconstruct_q8_fold<4>(trellis, w, g0, fs.first.data_ptr<float>(), q);
                    else launch_reconstruct_q8_fold<6>(trellis, w, g0, fs.first.data_ptr<float>(), q);
                    q8dnnl::gemm(q, x, reinterpret_cast<const int8_t*>(xq.data_ptr()) + g * Ms * k,
                                 reinterpret_cast<const int8_t*>(w.data_ptr()), fs.second.data_ptr<float>() + g0,
                                 sx.data_ptr<float>() + g * Ms, reinterpret_cast<fp16*>(yf.data_ptr()) + g0, Ms, k, ng, n, true);
                }
                return yf.narrow(0, 0, M).view(shape);
            }
            auto y = at::empty({Ms, n}, x.options().dtype(at::kHalf));
            for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
                int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
                auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
                if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
                q8dnnl::gemm(q, x, reinterpret_cast<const int8_t*>(xq.data_ptr()) + g * Ms * k,
                             reinterpret_cast<const int8_t*>(w.data_ptr()), swt.data_ptr<float>(),
                             sx.data_ptr<float>() + g * Ms, reinterpret_cast<fp16*>(y.data_ptr()) + g0, Ms, k, ng, n);
            }
            exl3_had_out_h(y.narrow(0, 0, M), svh, out);
            return out.view(shape);
        }
#endif
        for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
            int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1], ng = g1 - g0;
            auto w = at::empty({k, ng}, x.options().dtype(at::kChar));
            if (K == 4) launch_reconstruct_q8<4>(trellis, w, g0, q); else launch_reconstruct_q8<6>(trellis, w, g0, q);
            auto y = at::_int_mm(xq[g], w);                                   // [M, ng] int32
            int n_out = M * (ng / 128);
            auto run_out = [&](auto tag) {
                using TOut = decltype(tag);
                HadOutQ8Kernel<TOut> ko{y.data_ptr<int32_t>(), sx.data_ptr<float>() + g * M,
                                        reinterpret_cast<const fp16*>(svh.data_ptr()) + g0,
                                        reinterpret_cast<TOut*>(out.data_ptr()) + g0, (int)M, (int)ng, (int)n, sw};
                q.submit([&](sycl::handler& h) { h.parallel_for(sycl::nd_range<1>(round_up(n_out, local), local), ko); });
            };
            if (out.scalar_type() == at::kHalf) run_out(fp16{});
            else run_out(sycl::ext::oneapi::bfloat16{});
        }
        return out.view(shape);
    }
    auto xh = at::empty({S, M, k}, x.options().dtype(at::kHalf));
    exl3_had_in_rm(x2, suh, xh);
    auto y = at::empty({M, n}, x.options().dtype(at::kHalf));
    for (size_t g = 0; g + 1 < group_bounds.size(); ++g) {
        int64_t g0 = group_bounds[g], g1 = group_bounds[g + 1];
        for (int64_t n0 = g0; n0 < g1; n0 += slice_n) {
            int64_t n1 = std::min(n0 + slice_n, g1);
            auto w = weight_scratch(x.device(), k * (n1 - n0)).narrow(0, 0, k * (n1 - n0)).view({k, n1 - n0});
            exl3_reconstruct(trellis, w, n0, K, cb);
            auto yslice = y.narrow(1, n0, n1 - n0);
            at::matmul_out(yslice, xh[g], w);
        }
    }
    exl3_had_out_h(y, svh, out);
    return out.view(shape);
}

at::Tensor exl3_linear_meta(at::Tensor x, at::Tensor trellis, at::Tensor suh, at::Tensor svh, at::Tensor shard_of_nb,
                            std::vector<int64_t> group_bounds, int64_t K, int64_t cb, int64_t small_m_max,
                            int64_t slice_n) {
    auto shape = x.sizes().vec();
    shape.back() = svh.size(0);
    return at::empty(shape, x.options());
}

bool exl3_supported(int64_t K, int64_t cb) {
    if (cb == 2 && (K == 4 || K == 6)) return true;
#ifdef EXL3_ALL_CODEBOOKS
    if (cb == 2 && (K == 2 || K == 3 || K == 5)) return true;
    if ((cb == 0 || cb == 1) && (K == 4 || K == 6)) return true;
#endif
    return false;
}

void exl3_set_target_threads(int64_t n) { g_target_threads = (int)n; }
void exl3_set_target_threads_mb64(int64_t n) { g_target_threads_mb64 = (int)n; }
void exl3_set_target_threads_mb16(int64_t n) { g_target_threads_mb16 = (int)n; }
void exl3_set_vec_max_m(int64_t n) { g_vec_max_m = (int)n; }
void exl3_set_wave_cap(int64_t n) { g_wave_cap = (int)n; }

